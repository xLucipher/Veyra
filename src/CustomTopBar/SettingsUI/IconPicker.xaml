<UserControl x:Class="CustomTopBar.SettingsUI.IconPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:audio="clr-namespace:CustomTopBar.Widgets.Audio">
    <UserControl.Resources>
        <!-- Eine Kachel je Symbol -->
        <DataTemplate x:Key="IconTile">
            <Button Width="46" Height="46" Margin="3" Padding="0" Click="OnIconClick" Tag="{Binding Key}" ToolTip="{Binding Name}">
                <audio:AudioIconView IconKey="{Binding Key}" Size="22" />
            </Button>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="TilePanel">
            <WrapPanel Width="416" />
        </ItemsPanelTemplate>
        <Style x:Key="Header" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="3,10,0,4" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Aktuelle Auswahl: Klick öffnet das Raster -->
        <Button x:Name="OpenButton" HorizontalContentAlignment="Stretch" Click="OnOpenClick" Width="300" Padding="10,5">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                           VerticalAlignment="Center" Margin="10,0,0,0" Opacity="0.7" />
                <audio:AudioIconView x:Name="CurrentIcon" DockPanel.Dock="Left" Size="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock x:Name="CurrentName" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Button>

        <Popup x:Name="Picker" PlacementTarget="{Binding ElementName=OpenButton}" Placement="Bottom" VerticalOffset="6"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="#2B2C33" BorderBrush="#45FFFFFF" BorderThickness="1" CornerRadius="10" Padding="12,8,12,12">
                <StackPanel>
                    <Button x:Name="AutoButton" HorizontalContentAlignment="Left" Click="OnAutoClick" Margin="3,4,3,0" Padding="10,6">
                        <StackPanel Orientation="Horizontal">
                            <audio:AudioIconView x:Name="AutoIcon" Size="20" Margin="0,0,10,0" />
                            <TextBlock Text="Automatisch – passend zum Gerät" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Wiedergabe" Style="{StaticResource Header}" />
                    <ItemsControl x:Name="OutputIcons" ItemTemplate="{StaticResource IconTile}" ItemsPanel="{StaticResource TilePanel}" />
                    <TextBlock Text="Mikrofone" Style="{StaticResource Header}" />
                    <ItemsControl x:Name="InputIcons" ItemTemplate="{StaticResource IconTile}" ItemsPanel="{StaticResource TilePanel}" />
                    <TextBlock Text="Allgemein" Style="{StaticResource Header}" />
                    <ItemsControl x:Name="GeneralIcons" ItemTemplate="{StaticResource IconTile}" ItemsPanel="{StaticResource TilePanel}" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
