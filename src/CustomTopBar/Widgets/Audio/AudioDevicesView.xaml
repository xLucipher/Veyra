<UserControl x:Class="CustomTopBar.Widgets.Audio.AudioDevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CustomTopBar.Widgets.Audio"
             Focusable="False">
    <UserControl.Resources>
        <!-- Flacher Leisten-Button: dezenter Hover, Standardgerät mit Hintergrund und Akzentlinie -->
        <Style x:Key="BarButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bg" CornerRadius="6" Background="Transparent" Padding="8,5" Margin="1,0">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="Accent" Height="2" Width="14" CornerRadius="1" Background="#3DAEE9"
                                    VerticalAlignment="Bottom" Margin="0,0,0,1" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1FFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                <Setter TargetName="Accent" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsDefault}" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.55" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ItemsControl ItemsSource="{Binding Items}" Focusable="False" VerticalAlignment="Center">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Button Style="{StaticResource BarButton}" Command="{Binding Command}" ToolTip="{Binding ToolTip}">
                    <StackPanel Orientation="Horizontal">
                        <local:AudioIconView IconKey="{Binding IconKey}" Size="17" Visibility="{Binding IconVisibility}"
                                             Foreground="{Binding DataContext.Foreground, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                             VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Label}" Visibility="{Binding LabelVisibility}"
                                   FontFamily="{Binding DataContext.FontFamily, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                   Foreground="{Binding DataContext.Foreground, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                   FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
