<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>CustomTopBar</AssemblyName>
    <RootNamespace>CustomTopBar</RootNamespace>
    <Version>1.1.0</Version>
    <Product>CustomTopBar</Product>
    <Description>Ressourcenschonende, konfigurierbare Zusatz-Taskleiste für Windows 11</Description>

    <!-- Kleiner Speicher-Footprint: Workstation-GC ohne Hintergrund-GC-Thread -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <SatelliteResourceLanguages>de;en</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
