<Window x:Class="Veyra.Updates.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Veyra – Update"
        Icon="/Assets/Veyra.ico"
        ThemeMode="Dark"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">
    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    </Window.Resources>

    <StackPanel Margin="24,20,24,20">
        <!-- Kopf -->
        <DockPanel Margin="0,0,0,14">
            <Image DockPanel.Dock="Left" Source="/Assets/logo.png" Width="48" Height="48" Margin="0,0,16,0"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Update verfügbar" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText" Opacity="0.75" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <TextBlock Text="Soll das Update jetzt installiert werden? Veyra startet danach automatisch neu, deine Einstellungen bleiben erhalten."
                   TextWrapping="Wrap" Margin="0,0,0,12" />

        <!-- Neuerungen -->
        <TextBlock Text="Neuerungen" FontWeight="SemiBold" Margin="0,0,0,6" />
        <Border Background="#0FFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="6">
            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" Padding="12,10">
                <TextBlock x:Name="NotesText" TextWrapping="Wrap" FontSize="13" />
            </ScrollViewer>
        </Border>
        <TextBlock Margin="0,6,0,0" FontSize="12">
            <Hyperlink x:Name="ReleaseLink" Click="OnReleaseLinkClick">Release auf GitHub ansehen</Hyperlink>
        </TextBlock>

        <!-- Fortschritt (während der Installation) -->
        <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,16,0,0">
            <ProgressBar x:Name="Progress" Height="6" Minimum="0" Maximum="1" />
            <TextBlock x:Name="ProgressText" Margin="0,6,0,0" FontSize="12" Opacity="0.75" />
        </StackPanel>

        <TextBlock x:Name="ErrorText" Visibility="Collapsed" Foreground="#FF8A8A" TextWrapping="Wrap" Margin="0,14,0,0" />

        <!-- Aktionen -->
        <DockPanel Margin="0,20,0,0" LastChildFill="False">
            <Button x:Name="NoButton" DockPanel.Dock="Left" Content="Nein" MinWidth="100" Click="OnNoClick"
                    ToolTip="Diese Version überspringen – erst eine neuere Version wird wieder angeboten" />
            <Button x:Name="YesButton" DockPanel.Dock="Right" Content="Ja, installieren" MinWidth="140" Margin="8,0,0,0"
                    Click="OnYesClick" IsDefault="True" Style="{DynamicResource AccentButtonStyle}" />
            <Button x:Name="LaterButton" DockPanel.Dock="Right" Content="Später" MinWidth="100" Click="OnLaterClick"
                    IsCancel="True" ToolTip="In 24 Stunden erneut fragen" />
        </DockPanel>
    </StackPanel>
</Window>
