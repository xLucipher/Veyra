<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Veyra.ico</ApplicationIcon>
    <AssemblyName>Veyra</AssemblyName>
    <RootNamespace>Veyra</RootNamespace>
    <Version>1.2.1</Version>
    <Product>Veyra</Product>
    <!-- Dateieigenschaften der EXE (Explorer → Eigenschaften → Details, Task-Manager) -->
    <AssemblyTitle>Veyra</AssemblyTitle>
    <Company>xLucipher</Company>
    <Authors>xLucipher</Authors>
    <Copyright>© 2026 xLucipher</Copyright>
    <Description>Ressourcenschonende, konfigurierbare Zusatz-Taskleiste für Windows 11</Description>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <!-- Kleiner Speicher-Footprint: Workstation-GC ohne Hintergrund-GC-Thread -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <SatelliteResourceLanguages>de;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Logo/Icon (erzeugt von build/branding.ps1 aus assets/branding) -->
    <Resource Include="Assets\Veyra.ico" />
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

</Project>
