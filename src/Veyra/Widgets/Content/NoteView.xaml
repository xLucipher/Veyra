<UserControl x:Class="Veyra.Widgets.Content.NoteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False"
             MouseLeftButtonUp="OnClick">
    <!-- Notiz: Text mit optionalem Zettel-Hintergrund; Umbruch ab der eingestellten Breite -->
    <Border Background="{Binding Background}" CornerRadius="6" Padding="{Binding Padding}" VerticalAlignment="Center">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding EditOnClick}" Value="True">
                        <Setter Property="Cursor" Value="Hand" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <TextBlock Text="{Binding DisplayText}" Foreground="{Binding Foreground}" Opacity="{Binding TextOpacity}"
                   FontFamily="{Binding FontFamily}" FontSize="{Binding FontSize}" FontWeight="{Binding FontWeight}"
                   MaxWidth="{Binding MaxTextWidth}" TextWrapping="{Binding Wrapping}" TextAlignment="{Binding Alignment}"
                   VerticalAlignment="Center" />
    </Border>
</UserControl>
