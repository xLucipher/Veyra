<UserControl x:Class="Veyra.Widgets.Clock.ClockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False"
             Cursor="Hand"
             ToolTip="Kalender öffnen"
             MouseLeftButtonUp="OnClick">
    <!-- Transparenter Hintergrund: die ganze Fläche (auch zwischen den Zeilen) ist klickbar.
         Tabellenziffern: alle Ziffern gleich breit → die zentrierte Uhr wackelt nicht im Sekundentakt. -->
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Background="Transparent">
        <TextBlock Text="{Binding TimeText}"
                   FontFamily="{Binding FontFamily}"
                   FontSize="{Binding FontSize}"
                   FontWeight="{Binding FontWeight}"
                   Foreground="{Binding Foreground}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   Typography.NumeralAlignment="Tabular" />
        <TextBlock Text="{Binding DateText}"
                   Visibility="{Binding DateVisibility}"
                   FontFamily="{Binding FontFamily}"
                   FontSize="{Binding DateFontSize}"
                   Foreground="{Binding DateForeground}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="0,-1,0,0"
                   Typography.NumeralAlignment="Tabular" />
    </StackPanel>
</UserControl>
