<w:FlyoutWindow x:Class="Veyra.Widgets.Timers.TimerFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="clr-namespace:Veyra.Widgets"
        Title="Timer"
        ThemeMode="Dark"
        Width="360"
        Background="#2A2B32">
    <Border Style="{StaticResource FlyoutFrame}">
        <StackPanel>
            <TextBlock Text="Timer" Style="{StaticResource FlyoutTitle}" />
            <TextBlock Text="Noch keine Timer – füge unten einen hinzu." Visibility="{Binding NoTimersVisibility}" Style="{StaticResource FlyoutSubtitle}" />

            <ScrollViewer MaxHeight="460" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#14FFFFFF" CornerRadius="6" Padding="12,10" Margin="0,4">
                                <StackPanel>
                                    <!-- Name (bearbeitbar) · Status -->
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" FontSize="12" Opacity="0.65" VerticalAlignment="Center" Margin="10,0,0,0" />
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" FontSize="13" MinHeight="0" Padding="6,3"
                                                 Background="Transparent" BorderThickness="0" ToolTip="Name des Timers" />
                                    </DockPanel>
                                    <!-- Restzeit · Start/Pause · Zurücksetzen · Entfernen -->
                                    <DockPanel Margin="0,6,0,0">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Command="{Binding PrimaryCommand}" ToolTip="{Binding PrimaryToolTip}" Width="40" Height="34" Padding="0"
                                                    Style="{DynamicResource AccentButtonStyle}">
                                                <TextBlock Text="{Binding PrimaryGlyph}" Style="{StaticResource FlyoutGlyph}" />
                                            </Button>
                                            <Button Command="{Binding ResetCommand}" ToolTip="Zurücksetzen" Width="40" Height="34" Padding="0" Margin="6,0,0,0">
                                                <TextBlock Text="&#xE777;" Style="{StaticResource FlyoutGlyph}" />
                                            </Button>
                                            <Button Command="{Binding RemoveCommand}" ToolTip="Timer entfernen" Width="40" Height="34" Padding="0" Margin="6,0,0,0">
                                                <TextBlock Text="&#xE74D;" Style="{StaticResource FlyoutGlyph}" />
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Text="{Binding RemainingText}" Foreground="{Binding TextBrush}" FontSize="28" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                                    </DockPanel>
                                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding RemainingFraction, Mode=OneWay}" Height="3" Margin="0,8,0,0"
                                                 Visibility="{Binding ProgressVisibility}" />
                                    <!-- Dauer: nur solange der Timer nicht läuft -->
                                    <DockPanel Visibility="{Binding EditVisibility}" Margin="0,8,0,0">
                                        <TextBlock DockPanel.Dock="Left" Text="Dauer" FontSize="12.5" Opacity="0.65" VerticalAlignment="Center" Margin="6,0,12,0" />
                                        <TextBox Text="{Binding DurationText, UpdateSourceTrigger=LostFocus}" FontSize="13" MinHeight="0" Padding="6,3"
                                                 ToolTip="z. B. 5 (Minuten), 1:30 (min:s), 1:00:00 (h:min:s) oder 1h 30m" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Button Command="{Binding AddTimerCommand}" HorizontalAlignment="Left" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" Style="{StaticResource FlyoutGlyph}" FontSize="12" Margin="0,0,8,0" />
                    <TextBlock Text="Timer hinzufügen" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</w:FlyoutWindow>
