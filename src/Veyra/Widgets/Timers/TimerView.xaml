<UserControl x:Class="Veyra.Widgets.Timers.TimerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False"
             ToolTip="{Binding ToolTipText}"
             MouseLeftButtonUp="OnClick">
    <!-- Sanduhr · je angezeigtem Timer: Name (optional), Restzeit und darunter ein leerlaufender Balken -->
    <Border Style="{StaticResource WidgetHoverArea}" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
            <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                <Canvas Width="24" Height="24">
                    <Path Data="{Binding IconGeometry}" Stroke="{Binding IconBrush}" StrokeThickness="1.6"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Canvas>
            </Viewbox>
            <ItemsControl ItemsSource="{Binding BarItems}" Focusable="False" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="7,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" Visibility="{Binding NameVisibility}" MaxWidth="120" TextTrimming="CharacterEllipsis"
                                           FontFamily="{Binding DataContext.FontFamily, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           Foreground="{Binding TextBrush}" Opacity="0.7" FontSize="12" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBlock Text="{Binding RemainingText}" MinWidth="34"
                                           FontFamily="{Binding DataContext.FontFamily, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           Foreground="{Binding TextBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Typography.NumeralAlignment="Tabular" />
                            </StackPanel>
                            <Border Visibility="{Binding ProgressVisibility}" Height="2" CornerRadius="1" VerticalAlignment="Bottom" Margin="0,0,0,-4"
                                    Background="{Binding DataContext.TrackBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                <Border CornerRadius="1" Background="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="{Binding RemainingFraction}" />
                                    </Border.RenderTransform>
                                </Border>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
