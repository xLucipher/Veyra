<w:FlyoutWindow x:Class="Veyra.Widgets.Timers.StopwatchFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="clr-namespace:Veyra.Widgets"
        Title="Stoppuhr"
        ThemeMode="Dark"
        Width="320"
        Background="#2A2B32">
    <Border Style="{StaticResource FlyoutFrame}">
        <StackPanel>
            <TextBlock Text="Stoppuhr" Style="{StaticResource FlyoutTitle}" />
            <TextBlock Text="{Binding FlyoutElapsedText}" FontSize="36" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4"
                       Typography.NumeralAlignment="Tabular" />

            <!-- Start/Pause · Runde · Zurücksetzen (Leertaste, R, Entf) -->
            <UniformGrid Rows="1" Margin="0,8,0,0">
                <Button Command="{Binding StartPauseCommand}" Style="{DynamicResource AccentButtonStyle}" HorizontalAlignment="Stretch" Margin="0,0,4,0"
                        ToolTip="Leertaste">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding StartPauseGlyph}" Style="{StaticResource FlyoutGlyph}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding StartPauseText}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding LapCommand}" Visibility="{Binding LapsVisibility}" HorizontalAlignment="Stretch" Margin="4,0" ToolTip="R">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7C1;" Style="{StaticResource FlyoutGlyph}" Margin="0,0,8,0" />
                        <TextBlock Text="Runde" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ResetCommand}" HorizontalAlignment="Stretch" Margin="4,0,0,0" ToolTip="Entf">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE777;" Style="{StaticResource FlyoutGlyph}" Margin="0,0,8,0" />
                        <TextBlock Text="Zurück" />
                    </StackPanel>
                </Button>
            </UniformGrid>

            <!-- Runden: neueste oben -->
            <StackPanel Visibility="{Binding LapListVisibility}">
                <Border Style="{StaticResource FlyoutDivider}" Margin="0,14,0,6" />
                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Runde" Style="{StaticResource FlyoutLabel}" />
                    <TextBlock Grid.Column="1" Text="Rundenzeit" Style="{StaticResource FlyoutLabel}" />
                    <TextBlock Grid.Column="2" Text="Gesamt" Style="{StaticResource FlyoutLabel}" Margin="0,3,0,3" TextAlignment="Right" />
                </Grid>
                <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Laps}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Number}" Style="{StaticResource FlyoutValue}" Opacity="0.75" />
                                    <TextBlock Grid.Column="1" Text="{Binding LapTime}" Foreground="{Binding Brush}" Style="{StaticResource FlyoutValue}"
                                               FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
                                    <TextBlock Grid.Column="2" Text="{Binding Total}" Style="{StaticResource FlyoutValue}" TextAlignment="Right"
                                               Opacity="0.75" Typography.NumeralAlignment="Tabular" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </StackPanel>
    </Border>
</w:FlyoutWindow>
