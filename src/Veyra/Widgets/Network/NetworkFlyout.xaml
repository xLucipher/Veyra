<w:FlyoutWindow x:Class="Veyra.Widgets.Network.NetworkFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="clr-namespace:Veyra.Widgets"
        Title="Netzwerk"
        ThemeMode="Dark"
        Width="400"
        Background="#2A2B32">
    <Border Style="{StaticResource FlyoutFrame}">
        <StackPanel>
            <!-- Kopf: Symbol, Netzwerkname, Status -->
            <DockPanel>
                <Grid DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock Text="{Binding Glyph}" Opacity="{Binding GlyphOpacity}" FontFamily="{StaticResource WidgetIconFont}" FontSize="26" />
                    <TextBlock Text="{Binding LevelGlyph}" FontFamily="{StaticResource WidgetIconFont}" FontSize="26" />
                </Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusTitle}" Style="{StaticResource FlyoutTitle}" />
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource FlyoutSubtitle}" />
                </StackPanel>
            </DockPanel>

            <!-- Details: Beschriftung links, Wert rechts -->
            <ItemsControl ItemsSource="{Binding Details}" Margin="0,12,0,0" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Label}" Style="{StaticResource FlyoutLabel}" />
                            <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource FlyoutValue}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Windows gibt SSID und Signal ohne Standortzugriff nicht heraus (ab Windows 11 24H2) -->
            <Border Visibility="{Binding RestrictedVisibility}" Background="#14FFFFFF" CornerRadius="6" Padding="10,8" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8"
                               Text="Windows gibt WLAN-Name und Signalstärke nur frei, wenn Desktop-Apps auf den Standort zugreifen dürfen. Angezeigt wird der Name aus der Windows-Netzwerkliste." />
                    <Button Content="Standorteinstellungen …" Command="{Binding OpenLocationSettingsCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Button Visibility="{Binding SettingsButtonVisibility}" Command="{Binding OpenSettingsCommand}" HorizontalAlignment="Right" Margin="0,14,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE713;" Style="{StaticResource FlyoutGlyph}" Margin="0,0,8,0" />
                    <TextBlock Text="Netzwerkeinstellungen" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</w:FlyoutWindow>
