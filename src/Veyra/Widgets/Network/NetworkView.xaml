<UserControl x:Class="Veyra.Widgets.Network.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False"
             ToolTip="{Binding ToolTipText}"
             MouseLeftButtonUp="OnClick">
    <!-- Symbol (bei WLAN zweilagig: abgedunkeltes Vollsymbol + erreichte Stufe) · Netzwerkname · Signal -->
    <Border Style="{StaticResource WidgetHoverArea}" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
            <Grid VerticalAlignment="Center">
                <TextBlock Text="{Binding Glyph}" Opacity="{Binding GlyphOpacity}" Foreground="{Binding IconBrush}"
                           FontFamily="{StaticResource WidgetIconFont}" FontSize="16" />
                <TextBlock Text="{Binding LevelGlyph}" Foreground="{Binding IconBrush}"
                           FontFamily="{StaticResource WidgetIconFont}" FontSize="16" />
            </Grid>
            <TextBlock Text="{Binding NameText}" Visibility="{Binding NameVisibility}" MaxWidth="180" TextTrimming="CharacterEllipsis"
                       FontFamily="{Binding FontFamily}" FontSize="13" Foreground="{Binding Foreground}"
                       VerticalAlignment="Center" Margin="7,0,0,0" />
            <TextBlock Text="{Binding SignalText}" Visibility="{Binding SignalVisibility}"
                       FontFamily="{Binding FontFamily}" FontSize="12" Foreground="{Binding Foreground}" Opacity="0.7"
                       VerticalAlignment="Center" Margin="6,0,0,0" Typography.NumeralAlignment="Tabular" />
        </StackPanel>
    </Border>
</UserControl>
