<w:FlyoutWindow x:Class="Veyra.Widgets.Weather.WeatherFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="clr-namespace:Veyra.Widgets"
        Title="Wetter"
        ThemeMode="Dark"
        Width="440"
        Background="#2A2B32">
    <Window.Resources>
        <FontFamily x:Key="WeatherFont">Segoe UI Symbol</FontFamily>
    </Window.Resources>
    <Border Style="{StaticResource FlyoutFrame}">
        <StackPanel>
            <DockPanel>
                <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}" ToolTip="Jetzt neu laden" Width="36" Height="32" Padding="0" VerticalAlignment="Top">
                    <TextBlock Text="&#xE72C;" Style="{StaticResource FlyoutGlyph}" FontSize="13" />
                </Button>
                <StackPanel>
                    <TextBlock Text="{Binding Location}" Style="{StaticResource FlyoutTitle}" />
                    <TextBlock Text="{Binding Status}" Style="{StaticResource FlyoutSubtitle}" />
                </StackPanel>
            </DockPanel>

            <StackPanel Visibility="{Binding ForecastVisibility}">
                <!-- Jetzt -->
                <DockPanel Margin="0,14,0,0">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding CurrentGlyph}" FontFamily="{StaticResource WeatherFont}" FontSize="40"
                               VerticalAlignment="Center" Margin="0,0,14,0" />
                    <TextBlock DockPanel.Dock="Left" Text="{Binding CurrentTemperature}" FontSize="38" FontWeight="SemiBold" VerticalAlignment="Center"
                               Margin="0,0,14,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentCondition}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding CurrentDetails}" FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
                <TextBlock Text="{Binding SunText}" FontSize="12" Opacity="0.55" Margin="0,8,0,0" />

                <!-- Nächste Stunden -->
                <Border Style="{StaticResource FlyoutDivider}" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly">
                    <ItemsControl ItemsSource="{Binding Hours}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="54" Margin="0,0,2,6">
                                    <TextBlock Text="{Binding Time}" FontSize="11.5" Opacity="0.6" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource WeatherFont}" FontSize="20" HorizontalAlignment="Center" Margin="0,3" />
                                    <TextBlock Text="{Binding Temperature}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding Rain}" FontSize="11" Foreground="#7FC4F0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Nächste Tage -->
                <Border Style="{StaticResource FlyoutDivider}" />
                <ItemsControl ItemsSource="{Binding Days}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Day}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{Binding Glyph}" FontFamily="{StaticResource WeatherFont}" FontSize="17" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Condition}" FontSize="12" Opacity="0.6" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="3" Text="{Binding Rain}" FontSize="11.5" Foreground="#7FC4F0" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="4" Text="{Binding Max}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="5" Text="{Binding Min}" FontSize="13" Opacity="0.55" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <TextBlock Margin="0,12,0,0" FontSize="11" Opacity="0.5">
                <Hyperlink Command="{Binding OpenSourceCommand}" Foreground="#B4B7C2">Wetterdaten: Open-Meteo.com (CC BY 4.0)</Hyperlink>
            </TextBlock>
        </StackPanel>
    </Border>
</w:FlyoutWindow>
