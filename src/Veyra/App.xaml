<Application x:Class="Veyra.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <!-- Gemeinsame Stile der Widgets und ihrer Popups (Netzwerk, Lautstärke, Timer, Stoppuhr, Datenrate). -->
    <Application.Resources>
        <FontFamily x:Key="WidgetIconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Klickbare Fläche eines Widgets auf der Leiste: dezenter Hover wie bei den Audio-Buttons -->
        <Style x:Key="WidgetHoverArea" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1FFFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Popups: Rahmen, Überschrift, Beschriftung/Wert-Zeilen, runde Symbol-Buttons -->
        <Style x:Key="FlyoutFrame" TargetType="Border">
            <Setter Property="BorderBrush" Value="#3A3C46" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18,16,18,14" />
        </Style>
        <Style x:Key="FlyoutTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="FlyoutSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="FlyoutLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="Margin" Value="0,3,16,3" />
        </Style>
        <Style x:Key="FlyoutValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,3" />
        </Style>
        <Style x:Key="FlyoutGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource WidgetIconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="FlyoutDivider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="#3A3C46" />
            <Setter Property="Margin" Value="0,12" />
        </Style>
    </Application.Resources>
</Application>
