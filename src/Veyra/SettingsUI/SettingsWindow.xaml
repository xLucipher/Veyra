                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding Selected}" Content="{Binding Name}" Margin="0,3" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <DockPanel Style="{StaticResource Row}">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding DeviceBattery.ShowNames}" VerticalAlignment="Center" />
                                                <TextBlock Text="Gerätenamen auf der Fläche" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <TextBox DockPanel.Dock="Right" Width="140" VerticalAlignment="Center" Text="{Binding DeviceBattery.WarnLevel, UpdateSourceTrigger=PropertyChanged}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Warnen ab (%)" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Darunter orange, unter der Hälfte rot (außer beim Laden). 5–50." Style="{StaticResource RowHint}" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding DeviceBattery.NotifyLow}" VerticalAlignment="Center" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Benachrichtigung bei wenig Akku" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Einmal je Gerät, sobald es die Warnschwelle erreicht – erst nach dem Aufladen wieder." Style="{StaticResource RowHint}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </StackPanel>

                                        <!-- Öffentliche IP: Version, Anzeige, Abfrage -->
                                        <StackPanel Visibility="{Binding PublicIpVisibility}" Margin="0,6,0,0">
