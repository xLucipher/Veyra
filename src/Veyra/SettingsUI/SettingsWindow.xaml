                                            <DockPanel Style="{StaticResource Row}">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Brightness.ShowPercent}" VerticalAlignment="Center" />
                                                <TextBlock Text="Prozent neben dem Symbol" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <ComboBox DockPanel.Dock="Right" Width="220" VerticalAlignment="Center"
                                                          ItemsSource="{Binding DataContext.NightTemperatureOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding NightTemperature}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Nachtmodus: Farbtemperatur" Style="{StaticResource RowTitle}" />
