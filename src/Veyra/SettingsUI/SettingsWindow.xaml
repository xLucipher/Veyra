                                                <ComboBox DockPanel.Dock="Right" Width="180" VerticalAlignment="Center"
                                                          ItemsSource="{Binding DataContext.IpVersionOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding PublicIpShow}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Auf der Fläche" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Das Popup zeigt immer beide Adressen zum Kopieren." Style="{StaticResource RowHint}" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding PublicIp.ShowLabel}" VerticalAlignment="Center" />
