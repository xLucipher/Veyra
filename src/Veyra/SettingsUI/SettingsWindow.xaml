                                                    <TextBlock Text="Aktualisieren alle" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Nur solange die Fläche sichtbar ist. Daten von Open-Meteo.com – ohne Konto; übertragen wird nur der gewählte Ort." Style="{StaticResource RowHint}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Weather.ShowCondition}" VerticalAlignment="Center" />
                                                <TextBlock Text="Wetterlage als Text („Leicht bewölkt“)" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Weather.ShowHighLow}" VerticalAlignment="Center" />
