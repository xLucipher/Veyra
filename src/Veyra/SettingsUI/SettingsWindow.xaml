                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding ClockFontFamilies}" SelectedItem="{Binding ClockFontFamily}"
