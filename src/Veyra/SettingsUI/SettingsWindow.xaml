                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding IconColorTitle}" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="{Binding IconColorHint}" Visibility="{Binding IconColorHintVisibility}" Style="{StaticResource RowHint}" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}" Visibility="{Binding LabelColorVisibility}">
                                                <ui:ColorField DockPanel.Dock="Right" VerticalAlignment="Center" Value="{Binding LabelColor, UpdateSourceTrigger=PropertyChanged}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding LabelColorTitle}" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="{Binding LabelColorHint}" Style="{StaticResource RowHint}" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}" Visibility="{Binding IndicatorColorVisibility}">
                                                <ui:ColorField DockPanel.Dock="Right" VerticalAlignment="Center" Value="{Binding IndicatorColor, UpdateSourceTrigger=PropertyChanged}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding IndicatorColorTitle}" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="{Binding IndicatorColorHint}" Style="{StaticResource RowHint}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <Button DockPanel.Dock="Right" Content="Zurücksetzen" Command="{Binding ResetColorsCommand}" VerticalAlignment="Center" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Farben der Fläche verwenden" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="{Binding ResetColorsHint}" Style="{StaticResource RowHint}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                        </StackPanel>
                                        </StackPanel>
                                                    </DataTemplate>
                                                </ContentControl.ContentTemplate>
                                            </ContentControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Uhren: Format, Schrift und Datum dieser Uhr (jede Uhr hat eigene Werte) -->
