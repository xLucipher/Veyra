                                                    <TextBox Width="80" Text="{Binding NightFrom, UpdateSourceTrigger=LostFocus}" ToolTip="Beginn, z. B. 21:00" />
                                                    <TextBlock Text="bis" VerticalAlignment="Center" Margin="10,0" />
                                                    <TextBox Width="80" Text="{Binding NightTo, UpdateSourceTrigger=LostFocus}" ToolTip="Ende, z. B. 07:00" />
                                                </StackPanel>
                                                <TextBlock Text="Zeitfenster" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </StackPanel>

                                        <!-- Tastenkürzel je Aktion: Lautstärke, Timer, Stoppuhr, Medien, Zeichnen -->
