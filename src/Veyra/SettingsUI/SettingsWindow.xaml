                                <TextBlock Text="Schriftart" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                            </DockPanel>
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding FontWeightOptions}" DisplayMemberPath="Display" SelectedValuePath="Value"
