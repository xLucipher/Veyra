                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Weather.ShowLocation}" VerticalAlignment="Center" />
                                                <TextBlock Text="Ortsname neben der Temperatur" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </StackPanel>

                                        <!-- Geräte-Akku: Quellen, Geräte, Warnung -->
                                        <StackPanel Visibility="{Binding DeviceBatteryVisibility}" Margin="0,6,0,0">
                                            <Border Style="{StaticResource Divider}" />
                                            <DockPanel Style="{StaticResource Row}">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding DeviceBattery.Bluetooth}" VerticalAlignment="Center" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Bluetooth-Geräte" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Maus, Tastatur, Headset und Controller über Bluetooth – mit dem Akkustand, den auch Windows anzeigt." Style="{StaticResource RowHint}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding DeviceBattery.Receiver}" VerticalAlignment="Center" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Geräte mit Funk-Empfänger" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Maus, Tastatur und Headset mit eigenem Funk-Empfänger (Dongle) oder per Kabel – direkt am Gerät gelesen." Style="{StaticResource RowHint}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding AllBatteryDevices}" VerticalAlignment="Center" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Alle gefundenen Geräte anzeigen" Style="{StaticResource RowTitle}" />
