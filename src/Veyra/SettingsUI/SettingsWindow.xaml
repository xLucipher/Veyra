                                            <TextBlock Text="Tastenkürzel" Style="{StaticResource RowTitle}" Margin="0,8,0,0" />
                                            <TextBlock Text="Global – funktionieren auch in Spielen und während die Fläche bei Vollbild ausgeblendet ist. Hineinklicken und eine Kombination oder eine einzelne Taste (z. B. Bild auf) drücken, Rücktaste oder Entf löscht." Style="{StaticResource RowHint}" TextWrapping="Wrap" />
                                            <ItemsControl ItemsSource="{Binding HotkeyActions}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Style="{StaticResource Row}">
                                                            <ui:HotkeyBox DockPanel.Dock="Right" Width="240" VerticalAlignment="Center" Hotkey="{Binding Hotkey}" />
