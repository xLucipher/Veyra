                                                     MaxHeight="220" Margin="0,6,0,0" DisplayMemberPath="Display" />
                                            <DockPanel Style="{StaticResource Row}">
                                                <ComboBox DockPanel.Dock="Right" Width="180" VerticalAlignment="Center"
                                                          ItemsSource="{Binding DataContext.TemperatureUnitOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding WeatherUnit}" />
