                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding WeekFormatOptions}" DisplayMemberPath="Display" SelectedValuePath="Value"
                                          SelectedValue="{Binding WeekNumberFormat}" Width="200" VerticalAlignment="Center" />
                                <TextBlock Text="Format der Kalenderwoche" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                            </DockPanel>
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <ComboBox DockPanel.Dock="Right" IsEditable="True" ItemsSource="{Binding DateFontSizePresets}" Width="120" VerticalAlignment="Center"
                                          Text="{Binding ClockEdit.DateFontSize, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Schriftgröße Datum (px)" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                            </DockPanel>
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <ui:ColorField DockPanel.Dock="Right" VerticalAlignment="Center" Value="{Binding ClockEdit.DateFontColor, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Schriftfarbe Datum" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                            </DockPanel>
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding CultureOptions}" DisplayMemberPath="Display" SelectedValuePath="Value"
                                          SelectedValue="{Binding Culture}" Width="300" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Sprache" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Für Wochentage und Monatsnamen – auch im Kalender." Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE787;" Style="{StaticResource Glyph}" FontSize="20" Margin="0,0,14,0" />
                            <TextBlock Style="{StaticResource RowHint}" Margin="0" VerticalAlignment="Center"
                                       Text="Ein Klick auf Uhrzeit oder Datum auf der Fläche öffnet den Monatskalender. Klick daneben oder Esc schließt ihn." />
                        </DockPanel>
                    </Border>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                    <!-- ===== Tab: Position & Verhalten ===== -->
                    <TabItem Header="Position &amp; Verhalten">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,16,4,10">
                            <StackPanel>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Fläche" Style="{StaticResource CardTitle}" />
                                        <DockPanel Style="{StaticResource Row}">
                                            <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding BarModeOptions}" DisplayMemberPath="Display" SelectedValuePath="Value"
                                                      SelectedValue="{Binding BarMode}" Width="300" VerticalAlignment="Center" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Modus" Style="{StaticResource RowTitle}" />
                                                <TextBlock Text="Fixiert: oben angedockt über die volle Breite. Dynamisch: frei bewegliches Fenster mit eigener Größe und Ecken – z. B. als Desktop-Uhr." Style="{StaticResource RowHint}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource Divider}" />
                                        <DockPanel Style="{StaticResource Row}">
                                            <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding MonitorOptions}" DisplayMemberPath="Display" SelectedValuePath="Value"
                                                      SelectedValue="{Binding MonitorSelection}" Width="360" VerticalAlignment="Center" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Monitor" Style="{StaticResource RowTitle}" />
                                                <TextBlock Text="Wird der Monitor getrennt, wechselt die Fläche auf den primären und kehrt automatisch zurück." Style="{StaticResource RowHint}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource Divider}" Visibility="{Binding FixedVisibility}" />
                                        <DockPanel Style="{StaticResource Row}" Visibility="{Binding FixedVisibility}">
                                            <ComboBox DockPanel.Dock="Right" IsEditable="True" ItemsSource="{Binding HeightPresets}" Width="120" VerticalAlignment="Center"
                                                      Text="{Binding Bar.Appearance.Height, UpdateSourceTrigger=PropertyChanged}" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Höhe (px)" Style="{StaticResource RowTitle}" />
                                                <TextBlock Text="Auswahl oder eigener Wert (16–200). Wird mit der Windows-Skalierung vergrößert. Finden Widgets nebeneinander keinen Platz mehr, rücken sie in eine zweite Zeile, sofern die Leiste hoch genug ist (meist ab etwa 64 px)." Style="{StaticResource RowHint}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Fixierte Leiste: Vordergrund und Reservierung – je Leiste -->
                                <Border Style="{StaticResource Card}" Visibility="{Binding FixedVisibility}">
                                    <StackPanel>
                                        <TextBlock Text="Verhalten" Style="{StaticResource CardTitle}" />
                                        <DockPanel Style="{StaticResource Row}">
                                            <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Bar.Appearance.AlwaysOnTop}" VerticalAlignment="Center" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Immer im Vordergrund" Style="{StaticResource RowTitle}" />
                                                <TextBlock Text="Die Fläche bleibt über allen Fenstern, auch über der Windows-Taskleiste." Style="{StaticResource RowHint}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource Divider}" />
                                        <DockPanel Style="{StaticResource Row}">
                                            <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Bar.Appearance.ReserveScreenSpace}" VerticalAlignment="Center" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Bildschirmbereich reservieren" Style="{StaticResource RowTitle}" />
                                                <TextBlock Text="An: maximierte Fenster beginnen unterhalb der Fläche; bleibt sie im randlosen Spiel sichtbar, wird auch das Spiel darunter gelegt. Aus: die Fläche liegt über den Fenstern (Overlay)." Style="{StaticResource RowHint}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Dynamische Leiste: Größe, Position, Ebene -->
                                <Border Style="{StaticResource Card}" Visibility="{Binding DynamicVisibility}">
                                    <StackPanel>
                                        <TextBlock Text="Größe, Position und Ebene" Style="{StaticResource CardTitle}" />
                                        <TextBlock Style="{StaticResource RowHint}"
                                                   Text="Verschieben: die Fläche an einer freien Stelle oder an der Uhr ziehen. Größe: an den Rändern ziehen oder hier eingeben. Position und Größe werden automatisch gespeichert." />
                                        <DockPanel Style="{StaticResource Row}">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBox Width="90" Text="{Binding Bar.Appearance.Width, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="×" VerticalAlignment="Center" Margin="10,0" Opacity="0.7" />
                                                <TextBox Width="90" Text="{Binding Bar.Appearance.FloatingHeight, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Größe – Breite × Höhe (px)" Style="{StaticResource RowTitle}" />
                                                <TextBlock Text="Z. B. 200 × 200 für eine freistehende Uhr." Style="{StaticResource RowHint}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource Divider}" />
                                        <DockPanel Style="{StaticResource Row}">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBox Width="90" ToolTip="Abstand vom linken Monitorrand; leer = zentriert"
                                                         Text="{Binding Bar.Appearance.FloatingLeft, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                                <TextBlock Text="/" VerticalAlignment="Center" Margin="10,0" Opacity="0.7" />
                                                <TextBox Width="90" ToolTip="Abstand vom oberen Monitorrand"
                                                         Text="{Binding Bar.Appearance.FloatingTop, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                                <Button Content="Zentrieren" Command="{Binding CenterHorizontallyCommand}" Margin="10,0,0,0" />
                                            </StackPanel>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Position – links / oben (px)" Style="{StaticResource RowTitle}" />
                                                <TextBlock Text="Relativ zum gewählten Monitor. Links leer = horizontal zentriert." Style="{StaticResource RowHint}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource Divider}" />
                                        <DockPanel Style="{StaticResource Row}">
                                            <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding LayerOptions}" DisplayMemberPath="Display" SelectedValuePath="Value"
                                                      SelectedValue="{Binding Bar.Appearance.Layer}" Width="300" VerticalAlignment="Center" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Ebene" Style="{StaticResource RowTitle}" />
                                                <TextBlock Text="„Im Hintergrund“ liegt hinter allen Fenstern – wie ein Widget auf dem Desktop." Style="{StaticResource RowHint}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Anordnung der Widgets und Sperre -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Anordnung" Style="{StaticResource CardTitle}" />
                                        <DockPanel Style="{StaticResource Row}">
                                            <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Bar.Appearance.LockPosition}" VerticalAlignment="Center" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Position sperren" Style="{StaticResource RowTitle}" />
                                                <TextBlock Text="Widgets lassen sich nicht mehr verschieben, im dynamischen Modus auch die Fläche selbst nicht (Verschieben und Größe). Auch per Rechtsklick auf die Fläche umschaltbar." Style="{StaticResource RowHint}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource Divider}" />
                                        <DockPanel Style="{StaticResource Row}">
                                            <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Bar.Appearance.FreeWidgetPlacement}" VerticalAlignment="Center" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Freie Platzierung" Style="{StaticResource RowTitle}" />
                                                <TextBlock Style="{StaticResource RowHint}"
                                                           Text="Alle Widgets – auch die Uhr – lassen sich auf der Fläche frei verschieben und dürfen sich überlappen. Aus: die Uhr steht fest links, mittig oder rechts, die übrigen Widgets ordnen sich nebeneinander an. Die dynamische Fläche selbst verschiebst du an einer freien Stelle oder mit gedrückter Strg-Taste." />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource Divider}" />
                                        <DockPanel Style="{StaticResource Row}">
                                            <Button DockPanel.Dock="Right" Content="Zurücksetzen" Command="{Binding ResetFreePositionsCommand}" VerticalAlignment="Center" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Freie Positionen zurücksetzen" Style="{StaticResource RowTitle}" />
                                                <TextBlock Text="Setzt alle Widgets wieder an ihren Platz aus der normalen Anordnung." Style="{StaticResource RowHint}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <DockPanel Margin="2,6,0,8" LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left" Text="Erkannte Monitore" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                                    <Button DockPanel.Dock="Right" Command="{Binding RefreshMonitorsCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,8,0" />
                                            <TextBlock Text="Aktualisieren" />
                                        </StackPanel>
                                    </Button>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Monitors}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,8">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Left" Text="&#xE7F4;" Style="{StaticResource Glyph}" FontSize="22" Width="40" />
                                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource RowHint}" Margin="2,4,0,0"
                                           Text="Die Vollbild-Erkennung berücksichtigt nur den Monitor dieser Fläche – Vollbild auf anderen Monitoren blendet sie nicht aus." />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </DockPanel>
            <!-- ========== Allgemein 0: Profile ========== -->
            <ScrollViewer Style="{StaticResource Page}" Visibility="{Binding SelectedIndex, ElementName=GeneralNav, Converter={StaticResource PageVisibility}, ConverterParameter=0}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding NewProfileCommand}" Padding="14,6" VerticalAlignment="Top" Margin="0,2,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,8,0" />
                                <TextBlock Text="Neues Profil" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="Profile" Style="{StaticResource PageTitle}" />
                    </DockPanel>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE8F1;" Style="{StaticResource Glyph}" FontSize="20" Margin="0,0,14,0" />
                            <TextBlock Style="{StaticResource RowHint}" Margin="0" VerticalAlignment="Center"
                                       Text="Ein Profil ist eine eigene Ansicht: alle Flächen mit ihren Widgets, Farben und Positionen. Ein neues Profil startet als Kopie der aktuellen Ansicht – danach links unter „Flächen“ anpassen. Profilaktionen wirken sofort; offene Änderungen werden dabei vorher übernommen." />
                        </DockPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding ProfileRows}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,8">
                                    <Border.Resources>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Margin" Value="6,0,0,0" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </Border.Resources>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="14" Background="#1AFFFFFF" Margin="0,0,14,0" VerticalAlignment="Center"
                                                ToolTip="Nummer in der Profilauswahl (Taste 1–9)">
                                            <TextBlock Text="{Binding Number}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Border CornerRadius="9" Background="#333DA5F4" Padding="10,3" VerticalAlignment="Center" Visibility="{Binding ActiveVisibility}">
                                                <TextBlock Text="Aktiv" FontSize="12" FontWeight="SemiBold" Foreground="#8FD0FF" />
                                            </Border>
                                            <Button Content="Aktivieren" Command="{Binding ActivateCommand}" Visibility="{Binding InactiveVisibility}" />
                                            <Button Command="{Binding MoveUpCommand}" ToolTip="Nach oben (kleinere Nummer)">
                                                <TextBlock Text="&#xE70E;" Style="{StaticResource Glyph}" FontSize="12" />
                                            </Button>
                                            <Button Command="{Binding MoveDownCommand}" ToolTip="Nach unten (größere Nummer)">
                                                <TextBlock Text="&#xE70D;" Style="{StaticResource Glyph}" FontSize="12" />
                                            </Button>
                                            <Button Command="{Binding DuplicateCommand}" ToolTip="Duplizieren">
                                                <TextBlock Text="&#xE8C8;" Style="{StaticResource Glyph}" FontSize="13" />
                                            </Button>
                                            <Button Command="{Binding DeleteCommand}" ToolTip="Löschen">
                                                <TextBlock Text="&#xE74D;" Style="{StaticResource Glyph}" FontSize="13" />
                                            </Button>
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBox Text="{Binding Name}" MaxWidth="320" HorizontalAlignment="Left" MinWidth="200"
                                                     ToolTip="Name ändern – wird beim Verlassen des Feldes oder mit Enter gespeichert" KeyDown="OnProfileNameKeyDown" />
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource RowHint}" Margin="2,4,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource Card}" Margin="0,8,0,14">
                        <StackPanel>
                            <TextBlock Text="Profilauswahl" Style="{StaticResource CardTitle}" />
                            <DockPanel Style="{StaticResource Row}">
                                <ui:HotkeyBox DockPanel.Dock="Right" Width="240" VerticalAlignment="Center" Hotkey="{Binding ProfileHotkey}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Tastenkürzel" Style="{StaticResource RowTitle}" />
                                    <TextBlock Style="{StaticResource RowHint}"
                                               Text="Blendet über allem eine Auswahl ein, auch im Spiel (randloses Vollbild). Pfeiltasten und Enter oder die Zahlen 1–9 wechseln, Esc schließt. Bei exklusivem Vollbild kann Windows kein Fenster darüber zeigen." />
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <Button DockPanel.Dock="Right" Content="Jetzt öffnen" Command="{Binding ShowProfileOverlayCommand}" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Profilauswahl ausprobieren" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Auch per Rechtsklick auf eine Fläche erreichbar – dort stehen die Profile zusätzlich direkt zur Auswahl." Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ========== Allgemein 1: Vollbild & Spiele ========== -->
            <ScrollViewer Style="{StaticResource Page}" Visibility="{Binding SelectedIndex, ElementName=GeneralNav, Converter={StaticResource PageVisibility}, ConverterParameter=1}">
                <StackPanel>
                    <TextBlock Text="Vollbild &amp; Spiele" Style="{StaticResource PageTitle}" />
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE946;" Style="{StaticResource Glyph}" FontSize="20" Margin="0,0,14,0" />
                            <TextBlock Style="{StaticResource RowHint}" Margin="0" VerticalAlignment="Center"
                                       Text="Gilt für alle Flächen. „Immer im Vordergrund“ und „Bildschirmbereich reservieren“ stellst du je Fläche ein (Fläche → Position &amp; Verhalten), das Tastenkürzel der Profilauswahl unter „Profile verwalten“." />
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Vollbild" Style="{StaticResource CardTitle}" />
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Settings.Behavior.HideOnFullscreen}" VerticalAlignment="Center" />
                                <TextBlock Text="Bei exklusivem Vollbild ausblenden (klassische Spiele)" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                            </DockPanel>
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Settings.Behavior.HideOnBorderlessFullscreen}" VerticalAlignment="Center" />
                                <TextBlock Text="Bei randlosem Vollbild ausblenden (Borderless, Videos, Browser-F11)" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                            </DockPanel>
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding ShowDelayOptions}" DisplayMemberPath="Display" SelectedValuePath="Value"
                                          SelectedValue="{Binding Settings.Behavior.FullscreenShowDelayMs}" Width="160" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Wiedereinblenden nach" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Ausblenden erfolgt sofort; Einblenden erst, wenn der Zustand so lange stabil ist (kein Flackern bei Alt+Tab)." Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding SafetyIntervalOptions}" DisplayMemberPath="Display" SelectedValuePath="Value"
                                          SelectedValue="{Binding Settings.Behavior.FullscreenSafetyCheckIntervalMs}" Width="160" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Sicherheitsprüfung" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Zusatzprüfung für Fälle ohne Systemereignis. Kostet praktisch keine CPU." Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Ausnahmen" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Programm aus der Liste wählen und hinzufügen. Zum Entfernen die Zeile im Textfeld löschen." Style="{StaticResource RowHint}" />

                            <TextBlock Text="Nie als Vollbild behandeln" Style="{StaticResource RowTitle}" Margin="0,12,0,6" />
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="Hinzufügen" Command="{Binding AddExcludedCommand}" Margin="8,0,0,0" />
                                <ComboBox ItemsSource="{Binding RunningProcesses}" SelectedItem="{Binding ExcludeCandidate}" ItemsPanel="{StaticResource VirtualPanel}" />
                            </DockPanel>
                            <TextBox AcceptsReturn="True" Height="70" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                     Text="{Binding ExcludedProcessesText, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="Immer als Vollbild behandeln (sobald das Fenster den Arbeitsbereich ausfüllt)" Style="{StaticResource RowTitle}" Margin="0,16,0,6" />
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="Hinzufügen" Command="{Binding AddForcedCommand}" Margin="8,0,0,0" />
                                <ComboBox ItemsSource="{Binding RunningProcesses}" SelectedItem="{Binding ForceCandidate}" ItemsPanel="{StaticResource VirtualPanel}" />
                            </DockPanel>
                            <TextBox AcceptsReturn="True" Height="70" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                     Text="{Binding ForcedProcessesText, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Content="Programmliste aktualisieren" Command="{Binding RefreshProcessesCommand}" HorizontalAlignment="Left" Margin="0,10,0,4" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ========== Allgemein 2: Audiogeräte ========== -->
            <ScrollViewer Style="{StaticResource Page}" Visibility="{Binding SelectedIndex, ElementName=GeneralNav, Converter={StaticResource PageVisibility}, ConverterParameter=2}">
                <StackPanel>
                    <TextBlock Text="Audiogeräte" Style="{StaticResource PageTitle}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding LabelModeOptions}" DisplayMemberPath="Display" SelectedValuePath="Value"
                                          SelectedValue="{Binding Settings.Audio.LabelMode}" Width="200" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Darstellung der Buttons" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Klick auf einen Button auf der Fläche setzt das Gerät als Standard (Medien und Kommunikation). Das aktive Gerät ist hervorgehoben." Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <Button DockPanel.Dock="Right" Command="{Binding RefreshAudioDevicesCommand}" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,8,0" />
                                        <TextBlock Text="Aktualisieren" />
                                    </StackPanel>
                                </Button>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Erkannte Geräte" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Alle aktiven Geräte dieses Systems. Symbol und Kurzname gelten für alle Audio-Widgets; welche Geräte ein Widget zeigt, stellst du bei der Fläche im Tab „Widgets“ ein." Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Wiedergabegeräte" Style="{StaticResource CardTitle}" Margin="2,6,0,8" />
                    <ItemsControl ItemsSource="{Binding OutputDeviceRows}" ItemTemplate="{StaticResource AudioDeviceRow}" />
                    <TextBlock Text="Mikrofone" Style="{StaticResource CardTitle}" Margin="2,12,0,8" />
                    <ItemsControl ItemsSource="{Binding InputDeviceRows}" ItemTemplate="{StaticResource AudioDeviceRow}" />
                </StackPanel>
            </ScrollViewer>

            <!-- ========== Allgemein 3: System & Updates ========== -->
            <ScrollViewer Style="{StaticResource Page}" Visibility="{Binding SelectedIndex, ElementName=GeneralNav, Converter={StaticResource PageVisibility}, ConverterParameter=3}">
                <StackPanel>
                    <TextBlock Text="System &amp; Updates" Style="{StaticResource PageTitle}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Settings.System.StartWithWindows}" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Mit Windows starten" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Startet Veyra bei der Anmeldung. Keine Administratorrechte nötig." Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Settings.System.UseSoftwareRendering}" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Software-Rendering (empfohlen)" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Veyra nutzt keine GPU – ideal beim Spielen. Wirksam nach Neustart der Anwendung." Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Settings.System.EnableLogging}" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Ausführliche Protokollierung" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Inklusive Vollbild-Erkennung. Fehler werden immer protokolliert, Logs 7 Tage aufbewahrt." Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Updates" Style="{StaticResource CardTitle}" />
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Settings.Updates.AutoCheck}" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Automatisch nach Updates suchen" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Kurz nach dem Start und danach alle 6 Stunden auf GitHub. Bei einem neuen Release wirst du gefragt – nie während eines Vollbildspiels." Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Command="{Binding OpenReleasesCommand}" Margin="0,0,8,0" Content="Release-Seite" />
                                    <Button Command="{Binding CheckForUpdatesCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE895;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,8,0" />
                                            <TextBlock Text="Jetzt nach Updates suchen" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentVersionText}" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Dateien" Style="{StaticResource CardTitle}" />
                            <DockPanel Style="{StaticResource Row}">
                                <Button DockPanel.Dock="Right" Content="Öffnen" Command="{Binding OpenSettingsFileCommand}" MinWidth="100" Margin="12,0,0,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Konfiguration" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="{Binding SettingsFilePath}" Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <Button DockPanel.Dock="Right" Content="Öffnen" Command="{Binding OpenLogFolderCommand}" MinWidth="100" Margin="12,0,0,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Protokolle" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="{Binding LogDirectory}" Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <Button DockPanel.Dock="Right" Content="Öffnen" Command="{Binding OpenBackupFolderCommand}" MinWidth="100" Margin="12,0,0,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Sicherungen" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Vor jedem Speichern wird die bisherige Konfiguration gesichert – die letzten 10 Fassungen bleiben erhalten. Zum Wiederherstellen Veyra beenden und eine Sicherung als settings.json zurückkopieren." Style="{StaticResource RowHint}" />
                                    <TextBlock Text="{Binding BackupDirectory}" Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <DockPanel Style="{StaticResource Row}">
                            <Button DockPanel.Dock="Right" Command="{Binding ExitApplicationCommand}" MinWidth="100" Margin="12,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7E8;" Style="{StaticResource Glyph}" FontSize="14" Margin="0,0,8,0" />
                                    <TextBlock Text="Beenden" />
                                </StackPanel>
                            </Button>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Veyra beenden" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="Funktioniert auch, wenn die Fläche gerade wegen Vollbild ausgeblendet ist." Style="{StaticResource RowHint}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
