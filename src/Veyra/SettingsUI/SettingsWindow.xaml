<Window x:Class="Veyra.SettingsUI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Veyra.SettingsUI"
        xmlns:cfg="clr-namespace:Veyra.Configuration"
        xmlns:audio="clr-namespace:Veyra.Widgets.Audio"
        Title="Veyra – Einstellungen"
        Icon="/Assets/Veyra.ico"
        ThemeMode="Dark"
        Width="1040" Height="780" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen">

    <!-- Nur Layout-Stile auf nicht thematisierten Elementen (TextBlock/Border/Panels):
         Stile auf Steuerelementen würden das dunkle Fluent-Design überschreiben. -->
    <Window.Resources>
        <ui:IndexToVisibilityConverter x:Key="PageVisibility" />
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#0FFFFFFF" />
            <Setter Property="BorderBrush" Value="#1AFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,8" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="RowHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,24,0" />
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Page" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Padding" Value="28,22,28,10" />
        </Style>
        <ItemsPanelTemplate x:Key="VirtualPanel">
            <VirtualizingStackPanel />
        </ItemsPanelTemplate>
        <DataTemplate x:Key="FontItem">
            <TextBlock Text="{Binding}" FontFamily="{Binding}" />
        </DataTemplate>
        <!-- Eine Zeile je Audiogerät: Symbol per Raster-Auswahl, eigener Kurzname -->
        <DataTemplate x:Key="AudioDeviceRow">
            <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,8">
                <DockPanel>
                    <audio:AudioIconView DockPanel.Dock="Left" IconKey="{Binding IconKey}" Size="24" Margin="0,0,16,0" VerticalAlignment="Center" />
                    <TextBox DockPanel.Dock="Right" Width="170" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Margin="10,0,0,0"
                             VerticalAlignment="Center" ToolTip="Eigener Kurzname (leer = Gerätename)" />
                    <ui:IconPicker DockPanel.Dock="Right" VerticalAlignment="Center"
                                   SelectedKey="{Binding Icon, UpdateSourceTrigger=PropertyChanged}" AutoKey="{Binding AutoIconKey}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource RowTitle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        <TextBlock Text="{Binding State}" Style="{StaticResource RowHint}" Foreground="#6CCB5F" Opacity="1" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>

        <!-- ===================== Fußleiste ===================== -->
        <Border DockPanel.Dock="Bottom" Background="#0AFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Command="{Binding ResetCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE777;" Style="{StaticResource Glyph}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Standardwerte" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" Content="Übernehmen" Command="{Binding ApplyCommand}" Margin="8,0,0,0" MinWidth="120" />
                <Button DockPanel.Dock="Right" Content="Abbrechen" Command="{Binding CancelCommand}" IsCancel="True" Margin="8,0,0,0" MinWidth="120" />
                <Button DockPanel.Dock="Right" Content="OK" Command="{Binding OkCommand}" IsDefault="True" MinWidth="120" Style="{DynamicResource AccentButtonStyle}" />
                <TextBlock DockPanel.Dock="Left" Text="{Binding StatusText}" Foreground="#6CCB5F"
                           VerticalAlignment="Center" Margin="16,0" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- ===================== Navigation ===================== -->
        <Border DockPanel.Dock="Left" Width="230" Padding="10,16,10,10" Background="#08FFFFFF" BorderBrush="#14FFFFFF" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,0,0,18">
                    <Image Source="/Assets/logo.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Veyra" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
                <ListBox x:Name="Nav" SelectedIndex="0" Background="Transparent" BorderThickness="0">
                    <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource Glyph}" Width="30" /><TextBlock Text="Allgemein" VerticalAlignment="Center" /></StackPanel></ListBoxItem>
                    <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE790;" Style="{StaticResource Glyph}" Width="30" /><TextBlock Text="Darstellung" VerticalAlignment="Center" /></StackPanel></ListBoxItem>
                    <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE823;" Style="{StaticResource Glyph}" Width="30" /><TextBlock Text="Uhr &amp; Kalender" VerticalAlignment="Center" /></StackPanel></ListBoxItem>
                    <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Text="&#xECA5;" Style="{StaticResource Glyph}" Width="30" /><TextBlock Text="Widgets" VerticalAlignment="Center" /></StackPanel></ListBoxItem>
                    <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE767;" Style="{StaticResource Glyph}" Width="30" /><TextBlock Text="Audiogeräte" VerticalAlignment="Center" /></StackPanel></ListBoxItem>
                    <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7C4;" Style="{StaticResource Glyph}" Width="30" /><TextBlock Text="Fensterverhalten" VerticalAlignment="Center" /></StackPanel></ListBoxItem>
                    <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7F4;" Style="{StaticResource Glyph}" Width="30" /><TextBlock Text="Monitore" VerticalAlignment="Center" /></StackPanel></ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ===================== Seiten ===================== -->
        <Grid>

            <!-- ========== 0: Allgemein ========== -->
            <ScrollViewer Style="{StaticResource Page}" Visibility="{Binding SelectedIndex, ElementName=Nav, Converter={StaticResource PageVisibility}, ConverterParameter=0}">
                <StackPanel>
                    <TextBlock Text="Allgemein" Style="{StaticResource PageTitle}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Settings.System.StartWithWindows}" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Mit Windows starten" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Startet die Leiste bei der Anmeldung. Keine Administratorrechte nötig." Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Settings.System.UseSoftwareRendering}" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Software-Rendering (empfohlen)" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Die Leiste nutzt keine GPU – ideal beim Spielen. Wirksam nach Neustart der Anwendung." Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Settings.System.EnableLogging}" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Ausführliche Protokollierung" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Inklusive Vollbild-Erkennung. Fehler werden immer protokolliert, Logs 7 Tage aufbewahrt." Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Updates" Style="{StaticResource CardTitle}" />
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Settings.Updates.AutoCheck}" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Automatisch nach Updates suchen" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Kurz nach dem Start und danach alle 6 Stunden auf GitHub. Bei einem neuen Release wirst du gefragt – nie während eines Vollbildspiels." Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Command="{Binding OpenReleasesCommand}" Margin="0,0,8,0" Content="Release-Seite" />
                                    <Button Command="{Binding CheckForUpdatesCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE895;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,8,0" />
                                            <TextBlock Text="Jetzt nach Updates suchen" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentVersionText}" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Dateien" Style="{StaticResource CardTitle}" />
                            <DockPanel Style="{StaticResource Row}">
                                <Button DockPanel.Dock="Right" Content="Öffnen" Command="{Binding OpenSettingsFileCommand}" MinWidth="100" Margin="12,0,0,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Konfiguration" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="{Binding SettingsFilePath}" Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <Button DockPanel.Dock="Right" Content="Öffnen" Command="{Binding OpenLogFolderCommand}" MinWidth="100" Margin="12,0,0,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Protokolle" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="{Binding LogDirectory}" Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <DockPanel Style="{StaticResource Row}">
                            <Button DockPanel.Dock="Right" Command="{Binding ExitApplicationCommand}" MinWidth="100" Margin="12,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7E8;" Style="{StaticResource Glyph}" FontSize="14" Margin="0,0,8,0" />
                                    <TextBlock Text="Beenden" />
                                </StackPanel>
                            </Button>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Veyra beenden" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="Funktioniert auch, wenn die Leiste gerade wegen Vollbild ausgeblendet ist." Style="{StaticResource RowHint}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ========== 1: Darstellung ========== -->
            <ScrollViewer Style="{StaticResource Page}" Visibility="{Binding SelectedIndex, ElementName=Nav, Converter={StaticResource PageVisibility}, ConverterParameter=1}">
                <StackPanel>
                    <TextBlock Text="Darstellung" Style="{StaticResource PageTitle}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Leiste" Style="{StaticResource CardTitle}" />
                            <DockPanel Style="{StaticResource Row}">
                                <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding BarModeOptions}" DisplayMemberPath="Display" SelectedValuePath="Value"
                                          SelectedValue="{Binding BarMode}" Width="300" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Modus" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Fixiert: oben angedockt über die volle Breite. Dynamisch: frei bewegliches Fenster mit eigener Größe, Transparenz und Ecken – z. B. als Desktop-Uhr." Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Divider}" Visibility="{Binding FixedVisibility}" />
                            <DockPanel Style="{StaticResource Row}" Visibility="{Binding FixedVisibility}">
                                <ComboBox DockPanel.Dock="Right" IsEditable="True" ItemsSource="{Binding HeightPresets}" Width="120" VerticalAlignment="Center"
                                          Text="{Binding Settings.Appearance.Height, UpdateSourceTrigger=PropertyChanged}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Höhe (px)" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Auswahl oder eigener Wert (16–200). Wird mit der Windows-Skalierung vergrößert." Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <ui:ColorField DockPanel.Dock="Right" VerticalAlignment="Center" Value="{Binding Settings.Appearance.BackgroundColor, UpdateSourceTrigger=PropertyChanged}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Hintergrundfarbe" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Farbfeld anklicken für den Farbkreis." Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding BorderThicknessOptions}" DisplayMemberPath="Display" SelectedValuePath="Value"
                                          SelectedValue="{Binding Settings.Appearance.BorderThickness}" Width="120" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Rahmen" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Fixiert: Trennlinie unten. Dynamisch: Rahmen rundherum." Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <ui:ColorField DockPanel.Dock="Right" VerticalAlignment="Center" Value="{Binding Settings.Appearance.BorderColor, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Rahmenfarbe" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Nur im dynamischen Modus -->
                    <Border Style="{StaticResource Card}" Visibility="{Binding DynamicVisibility}">
                        <StackPanel>
                            <TextBlock Text="Dynamischer Modus" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource RowHint}"
                                       Text="Verschieben: die Leiste an einer freien Stelle oder an der Uhr ziehen. Größe: an den Rändern ziehen oder hier eingeben. Position und Größe werden automatisch gespeichert." />
                            <DockPanel Style="{StaticResource Row}">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox Width="90" Text="{Binding Settings.Appearance.Width, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="×" VerticalAlignment="Center" Margin="10,0" Opacity="0.7" />
                                    <TextBox Width="90" Text="{Binding Settings.Appearance.FloatingHeight, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Größe – Breite × Höhe (px)" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Z. B. 200 × 200 für eine freistehende Uhr." Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox Width="90" ToolTip="Abstand vom linken Monitorrand; leer = zentriert"
                                             Text="{Binding Settings.Appearance.FloatingLeft, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                    <TextBlock Text="/" VerticalAlignment="Center" Margin="10,0" Opacity="0.7" />
                                    <TextBox Width="90" ToolTip="Abstand vom oberen Monitorrand"
                                             Text="{Binding Settings.Appearance.FloatingTop, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                    <Button Content="Zentrieren" Command="{Binding CenterHorizontallyCommand}" Margin="10,0,0,0" />
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Position – links / oben (px)" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Relativ zum gewählten Monitor. Links leer = horizontal zentriert." Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding LayerOptions}" DisplayMemberPath="Display" SelectedValuePath="Value"
                                          SelectedValue="{Binding Settings.Appearance.Layer}" Width="300" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Ebene" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="„Im Hintergrund“ liegt hinter allen Fenstern – wie ein Widget auf dem Desktop." Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Settings.Appearance.LockPosition}" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Position sperren" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Verhindert versehentliches Verschieben und Größenändern. Auch per Rechtsklick auf die Leiste umschaltbar." Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Slider x:Name="OpacitySlider" Width="220" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                            IsSnapToTickEnabled="True" TickFrequency="0.05"
                                            Value="{Binding Settings.Appearance.BackgroundOpacity}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Value, ElementName=OpacitySlider, StringFormat={}{0:P0}}" Width="48" TextAlignment="Right"
                                               VerticalAlignment="Center" Margin="10,0,0,0" />
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Hintergrund-Deckkraft" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="0 % = komplett durchsichtig – dann sind nur die Inhalte (z. B. die Uhr) sichtbar und greifbar, Klicks daneben gehen zum Desktop." Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <ComboBox DockPanel.Dock="Right" IsEditable="True" ItemsSource="{Binding CornerRadiusPresets}" Width="120" VerticalAlignment="Center"
                                          Text="{Binding Settings.Appearance.CornerRadius, UpdateSourceTrigger=PropertyChanged}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Eckenradius (px)" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="0 = eckig. Halbe Höhe = Pillenform, bei quadratischer Größe ein Kreis." Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Schrift" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Standard für alle Widgets; die Uhr kann eigene Werte haben." Style="{StaticResource RowHint}" />
                            <DockPanel Style="{StaticResource Row}">
                                <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding FontFamilies}" SelectedItem="{Binding AppearanceFontFamily}"
                                          ItemTemplate="{StaticResource FontItem}" ItemsPanel="{StaticResource VirtualPanel}"
                                          MaxDropDownHeight="420" Width="300" VerticalAlignment="Center" />
                                <TextBlock Text="Schriftart" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                            </DockPanel>
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <ui:ColorField DockPanel.Dock="Right" VerticalAlignment="Center" Value="{Binding Settings.Appearance.ForegroundColor, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Schriftfarbe" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ========== 2: Uhr & Kalender ========== -->
            <ScrollViewer Style="{StaticResource Page}" Visibility="{Binding SelectedIndex, ElementName=Nav, Converter={StaticResource PageVisibility}, ConverterParameter=2}">
                <StackPanel>
                    <TextBlock Text="Uhr &amp; Kalender" Style="{StaticResource PageTitle}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Uhrzeit" Style="{StaticResource CardTitle}" />
                            <DockPanel Style="{StaticResource Row}">
                                <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding TimeFormatOptions}" DisplayMemberPath="Display" SelectedValuePath="Value"
                                          SelectedValue="{Binding TimeFormat}" Width="400" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Format" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Vorschau mit 9:05:42 Uhr. Wird exakt so angezeigt." Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <ComboBox DockPanel.Dock="Right" IsEditable="True" ItemsSource="{Binding FontSizePresets}" Width="120" VerticalAlignment="Center"
                                          Text="{Binding Settings.Clock.FontSize, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Schriftgröße (px)" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                            </DockPanel>
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding ClockFontFamilies}" SelectedItem="{Binding ClockFontFamily}"
                                          ItemTemplate="{StaticResource FontItem}" ItemsPanel="{StaticResource VirtualPanel}"
                                          MaxDropDownHeight="420" Width="300" VerticalAlignment="Center" />
                                <TextBlock Text="Schriftart" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                            </DockPanel>
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding FontWeightOptions}" DisplayMemberPath="Display" SelectedValuePath="Value"
                                          SelectedValue="{Binding FontWeight}" Width="160" VerticalAlignment="Center" />
                                <TextBlock Text="Schriftgewicht" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                            </DockPanel>
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <ui:ColorField DockPanel.Dock="Right" VerticalAlignment="Center" Value="{Binding Settings.Clock.FontColor, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Schriftfarbe" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Datum und Kalenderwoche" Style="{StaticResource CardTitle}" />
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Settings.Clock.ShowDate}" VerticalAlignment="Center" />
                                <TextBlock Text="Datum unter der Uhrzeit anzeigen" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                            </DockPanel>
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding DateFormatOptions}" DisplayMemberPath="Display" SelectedValuePath="Value"
                                          SelectedValue="{Binding DateFormat}" Width="400" VerticalAlignment="Center" />
                                <TextBlock Text="Datumsformat" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                            </DockPanel>
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Settings.Clock.ShowWeekNumber}" VerticalAlignment="Center" />
                                <TextBlock Text="Kalenderwoche anzeigen (ISO 8601)" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                            </DockPanel>
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding WeekFormatOptions}" DisplayMemberPath="Display" SelectedValuePath="Value"
                                          SelectedValue="{Binding WeekNumberFormat}" Width="200" VerticalAlignment="Center" />
                                <TextBlock Text="Format der Kalenderwoche" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                            </DockPanel>
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <ComboBox DockPanel.Dock="Right" IsEditable="True" ItemsSource="{Binding DateFontSizePresets}" Width="120" VerticalAlignment="Center"
                                          Text="{Binding Settings.Clock.DateFontSize, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Schriftgröße Datum (px)" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                            </DockPanel>
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <ui:ColorField DockPanel.Dock="Right" VerticalAlignment="Center" Value="{Binding Settings.Clock.DateFontColor, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Schriftfarbe Datum" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                            </DockPanel>
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding CultureOptions}" DisplayMemberPath="Display" SelectedValuePath="Value"
                                          SelectedValue="{Binding Culture}" Width="300" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Sprache" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Für Wochentage und Monatsnamen – auch im Kalender." Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE787;" Style="{StaticResource Glyph}" FontSize="20" Margin="0,0,14,0" />
                            <TextBlock Style="{StaticResource RowHint}" Margin="0" VerticalAlignment="Center"
                                       Text="Ein Klick auf Uhrzeit oder Datum in der Leiste öffnet den Monatskalender. Klick daneben oder Esc schließt ihn." />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ========== 3: Widgets ========== -->
            <ScrollViewer Style="{StaticResource Page}" Visibility="{Binding SelectedIndex, ElementName=Nav, Converter={StaticResource PageVisibility}, ConverterParameter=3}">
                <StackPanel>
                    <TextBlock Text="Widgets" Style="{StaticResource PageTitle}" />
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE759;" Style="{StaticResource Glyph}" FontSize="20" Margin="0,0,14,0" />
                            <TextBlock Style="{StaticResource RowHint}" Margin="0" VerticalAlignment="Center"
                                       Text="Die Uhr hat eine feste Position (Links, Mitte oder Rechts). Alle anderen Widgets verschiebst du direkt auf der Leiste per Drag &amp; Drop – sie überlappen sich nie und verdrängen nie die Uhr. Dasselbe Widget kann mehrfach hinzugefügt werden, z. B. ein Widget je Gerät." />
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Settings.Appearance.FreeWidgetPlacement}" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Freie Platzierung" Style="{StaticResource RowTitle}" />
                                    <TextBlock Style="{StaticResource RowHint}" TextWrapping="Wrap"
                                               Text="Alle Widgets – auch die Uhr – lassen sich auf der Leiste frei verschieben: hoch, runter, links, rechts. Sie bleiben dort, wo du sie loslässt, und dürfen sich überlappen. Bereich und Abstände der Uhr gelten dann nicht. Die dynamische Leiste selbst verschiebst du an einer freien Stelle oder mit gedrückter Strg-Taste." />
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <Button DockPanel.Dock="Right" Content="Zurücksetzen" Command="{Binding ResetFreePositionsCommand}" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Freie Positionen zurücksetzen" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Setzt alle Widgets wieder an ihren Platz aus der normalen Anordnung." Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding WidgetRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <!-- Kopfzeile: Symbol, Name, Aktiv, Entfernen -->
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Info.Glyph}" Style="{StaticResource Glyph}" FontSize="22" Width="40" />
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <CheckBox IsChecked="{Binding Enabled}" Content="Aktiv" MinWidth="0" />
                                                <Button Command="{Binding RemoveCommand}" ToolTip="Widget entfernen" Margin="8,0,0,0" Padding="10,6">
                                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Glyph}" FontSize="12" />
                                                </Button>
                                            </StackPanel>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Info.Name}" Style="{StaticResource RowTitle}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Info.Description}" Style="{StaticResource RowHint}" />
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- Feste Widgets: Bereich und Abstände -->
                                        <StackPanel Visibility="{Binding FixedVisibility}" Margin="40,6,0,0">
                                            <Border Style="{StaticResource Divider}" />
                                            <DockPanel Style="{StaticResource Row}">
                                                <ComboBox DockPanel.Dock="Right" Width="140" VerticalAlignment="Center"
                                                          ItemsSource="{Binding DataContext.SlotOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding Slot}" />
                                                <TextBlock Text="Position" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}" IsEnabled="{Binding OuterMarginEnabled}">
                                                <ComboBox DockPanel.Dock="Right" IsEditable="True" Width="140" VerticalAlignment="Center"
                                                          ItemsSource="{Binding DataContext.MarginPresets, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          Text="{Binding OuterMargin, UpdateSourceTrigger=PropertyChanged}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Abstand zum Rand (px)" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Nur Links/Rechts – in der Mitte ist die Uhr immer exakt zentriert." Style="{StaticResource RowHint}" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <ComboBox DockPanel.Dock="Right" IsEditable="True" Width="140" VerticalAlignment="Center"
                                                          ItemsSource="{Binding DataContext.SpacingPresets, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          Text="{Binding InnerSpacing, UpdateSourceTrigger=PropertyChanged}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Mindestabstand zu anderen Widgets (px)" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Freie Widgets kommen der Uhr nie näher als dieser Abstand." Style="{StaticResource RowHint}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </StackPanel>

                                        <!-- Freie Widgets: Position per Drag & Drop -->
                                        <TextBlock Visibility="{Binding FreeVisibility}" Text="{Binding PositionText}" Style="{StaticResource RowHint}" Margin="40,4,0,0" />

                                        <!-- Audio-Widgets: Geräteauswahl je Instanz -->
                                        <StackPanel Visibility="{Binding AudioVisibility}" Margin="40,6,0,0">
                                            <Border Style="{StaticResource Divider}" />
                                            <DockPanel Style="{StaticResource Row}">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding AllDevices}" VerticalAlignment="Center" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Alle aktiven Geräte anzeigen" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Aus: nur die angehakten Geräte. Für ein Widget je Gerät genau eines anhaken." Style="{StaticResource RowHint}" />
                                                </StackPanel>
                                            </DockPanel>
                                            <ItemsControl ItemsSource="{Binding Devices}" IsEnabled="{Binding DeviceListEnabled}" Margin="0,0,0,4">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding Selected}" Margin="0,3">
                                                            <StackPanel Orientation="Horizontal">
                                                                <audio:AudioIconView IconKey="{Binding IconKey}" Size="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource Card}" Margin="0,8,0,14">
                        <DockPanel Style="{StaticResource Row}">
                            <Button DockPanel.Dock="Right" Command="{Binding AddWidgetCommand}" Margin="8,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,8,0" />
                                    <TextBlock Text="Hinzufügen" />
                                </StackPanel>
                            </Button>
                            <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding WidgetCatalogItems}" SelectedItem="{Binding NewWidget}" Width="240" VerticalAlignment="Center">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" Width="26" />
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Widget hinzufügen" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="Weitere Widgets (CPU, RAM, Medien …) folgen in späteren Versionen." Style="{StaticResource RowHint}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ========== 4: Audiogeräte ========== -->
            <ScrollViewer Style="{StaticResource Page}" Visibility="{Binding SelectedIndex, ElementName=Nav, Converter={StaticResource PageVisibility}, ConverterParameter=4}">
                <StackPanel>
                    <TextBlock Text="Audiogeräte" Style="{StaticResource PageTitle}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding LabelModeOptions}" DisplayMemberPath="Display" SelectedValuePath="Value"
                                          SelectedValue="{Binding Settings.Audio.LabelMode}" Width="200" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Darstellung der Buttons" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Klick auf einen Button in der Leiste setzt das Gerät als Standard (Medien und Kommunikation). Das aktive Gerät ist hervorgehoben." Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <Button DockPanel.Dock="Right" Command="{Binding RefreshAudioDevicesCommand}" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,8,0" />
                                        <TextBlock Text="Aktualisieren" />
                                    </StackPanel>
                                </Button>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Erkannte Geräte" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Alle aktiven Geräte dieses Systems. Symbol und Kurzname gelten für alle Audio-Widgets; welche Geräte ein Widget zeigt, stellst du unter „Widgets“ ein." Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Wiedergabegeräte" Style="{StaticResource CardTitle}" Margin="2,6,0,8" />
                    <ItemsControl ItemsSource="{Binding OutputDeviceRows}" ItemTemplate="{StaticResource AudioDeviceRow}" />
                    <TextBlock Text="Mikrofone" Style="{StaticResource CardTitle}" Margin="2,12,0,8" />
                    <ItemsControl ItemsSource="{Binding InputDeviceRows}" ItemTemplate="{StaticResource AudioDeviceRow}" />
                </StackPanel>
            </ScrollViewer>

            <!-- ========== 5: Fensterverhalten ========== -->
            <ScrollViewer Style="{StaticResource Page}" Visibility="{Binding SelectedIndex, ElementName=Nav, Converter={StaticResource PageVisibility}, ConverterParameter=5}">
                <StackPanel>
                    <TextBlock Text="Fensterverhalten" Style="{StaticResource PageTitle}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Betriebsart" Style="{StaticResource CardTitle}" />
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Settings.Behavior.AlwaysOnTop}" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Immer im Vordergrund" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Fixierter Modus. Im dynamischen Modus gilt die Einstellung „Ebene“ unter Darstellung." Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Settings.Behavior.ReserveScreenSpace}" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Bildschirmbereich reservieren" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Nur im fixierten Modus. An: maximierte Fenster beginnen unterhalb der Leiste. Aus: die Leiste liegt über den Fenstern (Overlay)." Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}" Opacity="0.5">
                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Settings.Behavior.AutoHide}" IsEnabled="False" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Automatisch ausblenden (geplant)" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="In Version 1 noch nicht implementiert." Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Vollbild" Style="{StaticResource CardTitle}" />
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Settings.Behavior.HideOnFullscreen}" VerticalAlignment="Center" />
                                <TextBlock Text="Bei exklusivem Vollbild ausblenden (klassische Spiele)" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                            </DockPanel>
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Settings.Behavior.HideOnBorderlessFullscreen}" VerticalAlignment="Center" />
                                <TextBlock Text="Bei randlosem Vollbild ausblenden (Borderless, Videos, Browser-F11)" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                            </DockPanel>
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding ShowDelayOptions}" DisplayMemberPath="Display" SelectedValuePath="Value"
                                          SelectedValue="{Binding Settings.Behavior.FullscreenShowDelayMs}" Width="160" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Wiedereinblenden nach" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Ausblenden erfolgt sofort; Einblenden erst, wenn der Zustand so lange stabil ist (kein Flackern bei Alt+Tab)." Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding SafetyIntervalOptions}" DisplayMemberPath="Display" SelectedValuePath="Value"
                                          SelectedValue="{Binding Settings.Behavior.FullscreenSafetyCheckIntervalMs}" Width="160" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Sicherheitsprüfung" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Zusatzprüfung für Fälle ohne Systemereignis. Kostet praktisch keine CPU." Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Ausnahmen" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Programm aus der Liste wählen und hinzufügen. Zum Entfernen die Zeile im Textfeld löschen." Style="{StaticResource RowHint}" />

                            <TextBlock Text="Nie als Vollbild behandeln" Style="{StaticResource RowTitle}" Margin="0,12,0,6" />
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="Hinzufügen" Command="{Binding AddExcludedCommand}" Margin="8,0,0,0" />
                                <ComboBox ItemsSource="{Binding RunningProcesses}" SelectedItem="{Binding ExcludeCandidate}" ItemsPanel="{StaticResource VirtualPanel}" />
                            </DockPanel>
                            <TextBox AcceptsReturn="True" Height="70" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                     Text="{Binding ExcludedProcessesText, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="Immer als Vollbild behandeln (sobald das Fenster den Arbeitsbereich ausfüllt)" Style="{StaticResource RowTitle}" Margin="0,16,0,6" />
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="Hinzufügen" Command="{Binding AddForcedCommand}" Margin="8,0,0,0" />
                                <ComboBox ItemsSource="{Binding RunningProcesses}" SelectedItem="{Binding ForceCandidate}" ItemsPanel="{StaticResource VirtualPanel}" />
                            </DockPanel>
                            <TextBox AcceptsReturn="True" Height="70" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                     Text="{Binding ForcedProcessesText, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Content="Programmliste aktualisieren" Command="{Binding RefreshProcessesCommand}" HorizontalAlignment="Left" Margin="0,10,0,4" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ========== 6: Monitore ========== -->
            <ScrollViewer Style="{StaticResource Page}" Visibility="{Binding SelectedIndex, ElementName=Nav, Converter={StaticResource PageVisibility}, ConverterParameter=6}">
                <StackPanel>
                    <TextBlock Text="Monitore" Style="{StaticResource PageTitle}" />
                    <Border Style="{StaticResource Card}">
                        <DockPanel Style="{StaticResource Row}">
                            <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding MonitorOptions}" DisplayMemberPath="Display" SelectedValuePath="Value"
                                      SelectedValue="{Binding MonitorSelection}" Width="420" VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Leiste anzeigen auf" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="Wird der Monitor getrennt, wechselt die Leiste auf den primären und kehrt automatisch zurück." Style="{StaticResource RowHint}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <DockPanel Margin="2,6,0,8" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="Erkannte Monitore" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" Command="{Binding RefreshMonitorsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,8,0" />
                                <TextBlock Text="Aktualisieren" />
                            </StackPanel>
                        </Button>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Monitors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,8">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="&#xE7F4;" Style="{StaticResource Glyph}" FontSize="22" Width="40" />
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource RowHint}" Margin="2,4,0,0"
                               Text="Vollbild-Erkennung berücksichtigt nur den Monitor der Leiste – Vollbild auf anderen Monitoren blendet sie nicht aus." />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
