                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Fps.ShowProcess}" VerticalAlignment="Center" />
