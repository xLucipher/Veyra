                                                </StackPanel>
                                            </DockPanel>
                                            <TextBlock Text="Geräte werden gesucht …" Visibility="{Binding NoBatteryDevicesVisibility}" Style="{StaticResource RowHint}" Margin="0,0,0,4" />
