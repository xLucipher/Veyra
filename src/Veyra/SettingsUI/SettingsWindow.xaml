                                            <DockPanel Style="{StaticResource Row}">
                                                <ComboBox DockPanel.Dock="Right" Width="180" VerticalAlignment="Center"
                                                          ItemsSource="{Binding DataContext.WindUnitOptions, RelativeSource={RelativeSource AncestorType=Window}}"
