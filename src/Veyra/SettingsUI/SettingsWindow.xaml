<Window x:Class="Veyra.SettingsUI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Veyra.SettingsUI"
        xmlns:cfg="clr-namespace:Veyra.Configuration"
        xmlns:audio="clr-namespace:Veyra.Widgets.Audio"
        Title="Veyra – Einstellungen"
        Icon="/Assets/Veyra.ico"
        ThemeMode="Dark"
        Width="1200" Height="800" MinWidth="980" MinHeight="560"
        WindowStartupLocation="CenterScreen">

    <!-- Nur Layout-Stile auf nicht thematisierten Elementen (TextBlock/Border/Panels):
         Stile auf Steuerelementen würden das dunkle Fluent-Design überschreiben. -->
    <Window.Resources>
        <ui:IndexToVisibilityConverter x:Key="PageVisibility" />
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#0FFFFFFF" />
            <Setter Property="BorderBrush" Value="#1AFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,8" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="RowHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,24,0" />
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Abschnittsüberschrift in der Seitenleiste (PROFIL, FLÄCHEN, ALLGEMEIN) -->
        <Style x:Key="NavSection" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style x:Key="Page" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Padding" Value="28,22,28,10" />
        </Style>
        <ItemsPanelTemplate x:Key="VirtualPanel">
            <VirtualizingStackPanel />
        </ItemsPanelTemplate>
        <DataTemplate x:Key="FontItem">
            <TextBlock Text="{Binding}" FontFamily="{Binding}" />
        </DataTemplate>
        <!-- Eine Zeile je Audiogerät: Symbol per Raster-Auswahl, eigener Kurzname -->
        <DataTemplate x:Key="AudioDeviceRow">
            <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,8">
                <DockPanel>
                    <audio:AudioIconView DockPanel.Dock="Left" IconKey="{Binding IconKey}" Size="24" Margin="0,0,16,0" VerticalAlignment="Center" />
                    <TextBox DockPanel.Dock="Right" Width="170" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Margin="10,0,0,0"
                             VerticalAlignment="Center" ToolTip="Eigener Kurzname (leer = Gerätename)" />
                    <ui:IconPicker DockPanel.Dock="Right" VerticalAlignment="Center"
                                   SelectedKey="{Binding Icon, UpdateSourceTrigger=PropertyChanged}" AutoKey="{Binding AutoIconKey}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource RowTitle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        <TextBlock Text="{Binding State}" Style="{StaticResource RowHint}" Foreground="#6CCB5F" Opacity="1" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>

        <!-- ===================== Fußleiste ===================== -->
        <Border DockPanel.Dock="Bottom" Background="#0AFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Command="{Binding ResetCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE777;" Style="{StaticResource Glyph}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Standardwerte" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" Content="Übernehmen" Command="{Binding ApplyCommand}" Margin="8,0,0,0" MinWidth="120" />
                <Button DockPanel.Dock="Right" Content="Abbrechen" Command="{Binding CancelCommand}" IsCancel="True" Margin="8,0,0,0" MinWidth="120" />
                <Button DockPanel.Dock="Right" Content="OK" Command="{Binding OkCommand}" IsDefault="True" MinWidth="120" Style="{DynamicResource AccentButtonStyle}" />
                <TextBlock DockPanel.Dock="Left" Text="{Binding StatusText}" Foreground="#6CCB5F"
                           VerticalAlignment="Center" Margin="16,0" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- ===================== Navigation =====================
             Oben das Profil, darunter die Flächen dieses Profils, darunter die allgemeinen Bereiche.
             Alles unter einer Fläche gilt nur für diese Fläche, alles unter „Allgemein“ für alle. -->
        <Border DockPanel.Dock="Left" Width="250" Padding="10,16,10,10" Background="#08FFFFFF" BorderBrush="#14FFFFFF" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,0,0,16">
                    <Image Source="/Assets/logo.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Veyra" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>

                <!-- Profil: bestimmt, welche Flächen darunter stehen. Wechsel wirkt sofort. -->
                <StackPanel DockPanel.Dock="Top" Margin="6,0,6,14">
                    <TextBlock Text="PROFIL" Style="{StaticResource NavSection}" Margin="4,0,0,6" />
                    <ComboBox ItemsSource="{Binding ProfileRows}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedProfileRow}"
                              HorizontalAlignment="Stretch" ToolTip="Aktives Profil – ein Wechsel wirkt sofort (offene Änderungen werden vorher übernommen)" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel>
                        <TextBlock Text="FLÄCHEN" Style="{StaticResource NavSection}" Margin="10,0,0,4" />
                        <ListBox x:Name="BarNav" ItemsSource="{Binding BarOptions}" SelectedIndex="{Binding NavBarIndex}"
                                 Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE737;" Style="{StaticResource Glyph}" Width="30" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Command="{Binding AddBarCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Margin="4,2,4,0" Padding="12,6" Background="Transparent" BorderThickness="0" ToolTip="Neue Fläche in diesem Profil">
                            <StackPanel Orientation="Horizontal" Opacity="0.75">
                                <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="12" Width="26" />
                                <TextBlock Text="Neue Fläche" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <TextBlock Text="ALLGEMEIN" Style="{StaticResource NavSection}" Margin="10,18,0,4" />
                        <ListBox x:Name="GeneralNav" SelectedIndex="{Binding NavGeneralIndex}" Background="Transparent" BorderThickness="0">
                            <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F1;" Style="{StaticResource Glyph}" Width="30" /><TextBlock Text="Profile verwalten" VerticalAlignment="Center" /></StackPanel></ListBoxItem>
                            <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7FC;" Style="{StaticResource Glyph}" Width="30" /><TextBlock Text="Vollbild &amp; Spiele" VerticalAlignment="Center" /></StackPanel></ListBoxItem>
                            <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE767;" Style="{StaticResource Glyph}" Width="30" /><TextBlock Text="Audiogeräte" VerticalAlignment="Center" /></StackPanel></ListBoxItem>
                            <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource Glyph}" Width="30" /><TextBlock Text="System &amp; Updates" VerticalAlignment="Center" /></StackPanel></ListBoxItem>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===================== Inhalt ===================== -->
        <Grid>

            <!-- ========== Leiste: Kopf mit Name, darunter Tabs ========== -->
            <DockPanel Visibility="{Binding BarPageVisibility}" Margin="28,20,28,0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" Command="{Binding RemoveBarCommand}" IsEnabled="{Binding CanRemoveBar}" VerticalAlignment="Center"
                            Margin="10,0,0,0" ToolTip="Diese Fläche aus dem Profil entfernen (die letzte bleibt immer)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,8,0" />
                            <TextBlock Text="Fläche entfernen" />
                        </StackPanel>
                    </Button>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE737;" Style="{StaticResource Glyph}" FontSize="22" Margin="0,0,12,0" />
                    <TextBox Text="{Binding BarName, UpdateSourceTrigger=PropertyChanged}" FontSize="20" FontWeight="SemiBold" MaxWidth="420"
                             HorizontalAlignment="Left" MinWidth="240" VerticalAlignment="Center" ToolTip="Name der Fläche" />
                </DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding BarHintText}" Style="{StaticResource RowHint}" Margin="2,0,0,10" />

                <TabControl SelectedIndex="{Binding BarTabIndex}" Background="Transparent" BorderThickness="0" Padding="0">
                    <!-- ===== Tab: Aussehen ===== -->
                    <TabItem Header="Aussehen">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,16,4,10">
                            <StackPanel>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Hintergrund und Rahmen" Style="{StaticResource CardTitle}" />
                            <DockPanel Style="{StaticResource Row}">
                                <ui:ColorField DockPanel.Dock="Right" VerticalAlignment="Center" Value="{Binding Bar.Appearance.BackgroundColor, UpdateSourceTrigger=PropertyChanged}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Hintergrundfarbe" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Farbfeld anklicken für den Farbkreis, Pipette für eine Farbe vom Bildschirm." Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Slider x:Name="OpacitySlider" Width="220" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                            IsSnapToTickEnabled="True" TickFrequency="0.05"
                                            Value="{Binding Bar.Appearance.BackgroundOpacity}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Value, ElementName=OpacitySlider, StringFormat={}{0:P0}}" Width="48" TextAlignment="Right"
                                               VerticalAlignment="Center" Margin="10,0,0,0" />
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Hintergrund-Deckkraft" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="0 % = komplett durchsichtig – nur die Inhalte (z. B. die Uhr) sind sichtbar. Dynamisch gehen Klicks daneben zum Desktop, die fixierte Fläche bleibt für das Kontextmenü klickbar." Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding BorderThicknessOptions}" DisplayMemberPath="Display" SelectedValuePath="Value"
                                          SelectedValue="{Binding Bar.Appearance.BorderThickness}" Width="120" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Rahmen" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Fixiert: Trennlinie unten. Dynamisch: Rahmen rundherum." Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <ui:ColorField DockPanel.Dock="Right" VerticalAlignment="Center" Value="{Binding Bar.Appearance.BorderColor, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Rahmenfarbe" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                            </DockPanel>
                                        <StackPanel Visibility="{Binding DynamicVisibility}">
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <ComboBox DockPanel.Dock="Right" IsEditable="True" ItemsSource="{Binding CornerRadiusPresets}" Width="120" VerticalAlignment="Center"
                                          Text="{Binding Bar.Appearance.CornerRadius, UpdateSourceTrigger=PropertyChanged}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Eckenradius (px)" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="0 = eckig. Halbe Höhe = Pillenform, bei quadratischer Größe ein Kreis." Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Schrift" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Standard für alle Widgets. Uhren und Audio-Widgets können eigene Farben haben." Style="{StaticResource RowHint}" />
                            <DockPanel Style="{StaticResource Row}">
                                <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding FontFamilies}" SelectedItem="{Binding AppearanceFontFamily}"
                                          ItemTemplate="{StaticResource FontItem}" ItemsPanel="{StaticResource VirtualPanel}"
                                          MaxDropDownHeight="420" Width="300" VerticalAlignment="Center" />
                                <TextBlock Text="Schriftart" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                            </DockPanel>
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel Style="{StaticResource Row}">
                                <ui:ColorField DockPanel.Dock="Right" VerticalAlignment="Center" Value="{Binding Bar.Appearance.ForegroundColor, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Schriftfarbe" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <!-- ===== Tab: Widgets – Liste links, Einstellungen des gewählten Widgets rechts ===== -->
                    <TabItem Header="Widgets">
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="290" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <DockPanel Grid.Column="0" Margin="0,0,16,10">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Button x:Name="AddWidgetButton" Padding="14,7" Click="OnAddWidgetClick" HorizontalAlignment="Stretch" Style="{DynamicResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,8,0" />
                                    <TextBlock Text="Widget hinzufügen" />
                                </StackPanel>
                            </Button>
                            <Popup x:Name="AddWidgetPopup" IsOpen="{Binding IsAddWidgetOpen}" StaysOpen="False"
                                   PlacementTarget="{Binding ElementName=AddWidgetButton}" Placement="Custom"
                                   AllowsTransparency="True" PopupAnimation="Fade" Opened="OnAddWidgetPopupOpened" Closed="OnAddWidgetPopupClosed">
                                <Border x:Name="AddWidgetPanel" Width="704" Background="#2A2B32" BorderBrush="#3A3C46" BorderThickness="1"
                                        CornerRadius="8" Padding="16,14,8,8" Margin="0,0,8,8">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45" />
                                    </Border.Effect>
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top" Margin="0,0,8,8">
                                            <Grid DockPanel.Dock="Right" Width="240" VerticalAlignment="Center">
                                                <TextBox x:Name="WidgetSearchBox" Text="{Binding WidgetSearch, UpdateSourceTrigger=PropertyChanged}" Padding="30,0,0,0"
                                                         VerticalContentAlignment="Center" KeyDown="OnWidgetSearchKeyDown" />
                                                <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="13" Opacity="0.6" Margin="10,0,0,0" IsHitTestVisible="False" />
                                                <TextBlock Text="Suchen …" Opacity="0.45" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text, ElementName=WidgetSearchBox}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Widget hinzufügen" Style="{StaticResource CardTitle}" Margin="0" />
                                                <TextBlock Text="Klicken zum Hinzufügen · Enter fügt den ersten Treffer hinzu · Esc schließt" Style="{StaticResource RowHint}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <ScrollViewer MaxHeight="460" VerticalScrollBarVisibility="Auto" Focusable="False">
                                            <StackPanel>
                                                <ItemsControl ItemsSource="{Binding WidgetCatalogGroups}" Focusable="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,4,0,4">
                                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Opacity="0.55" Margin="2,0,0,6" />
                                                                <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Button Command="{Binding DataContext.AddWidgetCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                                                    CommandParameter="{Binding}" ToolTip="{Binding Description}"
                                                                                    Width="216" Height="64" Margin="0,0,8,8" Cursor="Hand"
                                                                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                                                                                <Button.Template>
                                                                                    <ControlTemplate TargetType="Button">
                                                                                        <Border x:Name="Tile" Background="#0AFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="6" Padding="12,8">
                                                                                            <ContentPresenter />
                                                                                        </Border>
                                                                                        <ControlTemplate.Triggers>
                                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                                <Setter TargetName="Tile" Property="Background" Value="#1FFFFFFF" />
                                                                                                <Setter TargetName="Tile" Property="BorderBrush" Value="#4D3DA5F4" />
                                                                                            </Trigger>
                                                                                            <Trigger Property="IsPressed" Value="True">
                                                                                                <Setter TargetName="Tile" Property="Background" Value="#2E3DA5F4" />
                                                                                            </Trigger>
                                                                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                                                                <Setter TargetName="Tile" Property="BorderBrush" Value="#3DA5F4" />
                                                                                            </Trigger>
                                                                                        </ControlTemplate.Triggers>
                                                                                    </ControlTemplate>
                                                                                </Button.Template>
                                                                                <DockPanel>
                                                                                    <Grid DockPanel.Dock="Left" Width="22" Margin="0,0,10,0" VerticalAlignment="Center">
                                                                                        <TextBlock x:Name="GlyphText" Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="18" />
                                                                                        <Viewbox Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                                            <Canvas Width="24" Height="24">
                                                                                                <Path Data="{Binding PathData}" Stroke="{Binding Foreground, ElementName=GlyphText}" StrokeThickness="1.6"
                                                                                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                                                            </Canvas>
                                                                                        </Viewbox>
                                                                                    </Grid>
                                                                                    <StackPanel VerticalAlignment="Center">
                                                                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                                        <TextBlock Text="{Binding Description}" FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                                                                                                   TextTrimming="CharacterEllipsis" MaxHeight="30" Margin="0,1,0,0" />
                                                                                    </StackPanel>
                                                                                </DockPanel>
                                                                            </Button>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="Kein Widget gefunden." Margin="2,8,0,12">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource RowHint}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding WidgetCatalogGroups.Count}" Value="0">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>
                            </Popup>
                        </Grid>
                                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource RowHint}" Margin="4,8,0,0"
                                           Text="Freie Widgets verschiebst du direkt auf der Fläche per Drag &amp; Drop. Anordnung und Sperre: Tab „Position &amp; Verhalten“." />
                                <Grid>
                                    <ListBox x:Name="WidgetList" ItemsSource="{Binding WidgetRows}" SelectedItem="{Binding SelectedWidget}"
                                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             HorizontalContentAlignment="Stretch">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,4">
                                                    <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Enabled}" MinWidth="0" VerticalAlignment="Center"
                                                              ToolTip="Aktiv – deaktivierte Widgets bleiben gespeichert, erscheinen aber nicht auf der Fläche" />
                                                    <Grid DockPanel.Dock="Left" Width="34" HorizontalAlignment="Left">
                                                        <TextBlock x:Name="GlyphText" Text="{Binding Info.Glyph}" Style="{StaticResource Glyph}" FontSize="18" />
                                                        <Viewbox Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <Canvas Width="24" Height="24">
                                                                <Path Data="{Binding Info.PathData}" Stroke="{Binding Foreground, ElementName=GlyphText}" StrokeThickness="1.6"
                                                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                            </Canvas>
                                                        </Viewbox>
                                                    </Grid>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Summary}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Visibility="{Binding NoWidgetsVisibility}" Style="{StaticResource RowHint}" Margin="6,8,0,0"
                                               Text="Diese Fläche hat noch keine Widgets – oben eins hinzufügen." />
                                </Grid>
                            </DockPanel>

                            <!-- Rechte Seite: Einstellungen des gewählten Widgets -->
                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,10" Visibility="{Binding WidgetDetailVisibility}">
                                <StackPanel>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <CheckBox IsChecked="{Binding SelectedWidget.Enabled}" Content="Aktiv" MinWidth="0" />
                                                    <Button Command="{Binding SelectedWidget.RemoveCommand}" ToolTip="Widget entfernen" Margin="8,0,0,0" Padding="10,6">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE74D;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,8,0" />
                                                            <TextBlock Text="Entfernen" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                                <Grid DockPanel.Dock="Left" Width="40" HorizontalAlignment="Left">
                                                    <TextBlock x:Name="DetailGlyph" Text="{Binding SelectedWidget.Info.Glyph}" Style="{StaticResource Glyph}" FontSize="22" />
                                                    <Viewbox Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <Canvas Width="24" Height="24">
                                                            <Path Data="{Binding SelectedWidget.Info.PathData}" Stroke="{Binding Foreground, ElementName=DetailGlyph}" StrokeThickness="1.6"
                                                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                        </Canvas>
                                                    </Viewbox>
                                                </Grid>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SelectedWidget.Title}" FontSize="16" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding SelectedWidget.Info.Description}" Style="{StaticResource RowHint}" />
                                                </StackPanel>
                                            </DockPanel>
                                            <ContentControl Content="{Binding SelectedWidget}" Focusable="False">
                                                <ContentControl.ContentTemplate>
                                                    <DataTemplate>
                                        <StackPanel>
                                        <!-- Alle Widgets: Größe -->
                                        <StackPanel Margin="0,6,0,0">
                                            <Border Style="{StaticResource Divider}" />
                                            <DockPanel Style="{StaticResource Row}">
                                                <ComboBox DockPanel.Dock="Right" IsEditable="True" Width="140" VerticalAlignment="Center"
                                                          ItemsSource="{Binding DataContext.ScalePresets, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          Text="{Binding ScalePercent, UpdateSourceTrigger=PropertyChanged}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Größe (%)" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="100 = normal. Vergrößert Schrift, Symbole und Abstände – z. B. für große dynamische Flächen." Style="{StaticResource RowHint}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </StackPanel>

                                        <!-- Feste Widgets: Bereich und Abstände -->
                                        <StackPanel Visibility="{Binding FixedVisibility}" Margin="0,6,0,0">
                                            <Border Style="{StaticResource Divider}" />
                                            <DockPanel Style="{StaticResource Row}">
                                                <ComboBox DockPanel.Dock="Right" Width="140" VerticalAlignment="Center"
                                                          ItemsSource="{Binding DataContext.SlotOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding Slot}" />
                                                <TextBlock Text="Position" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}" IsEnabled="{Binding OuterMarginEnabled}">
                                                <ComboBox DockPanel.Dock="Right" IsEditable="True" Width="140" VerticalAlignment="Center"
                                                          ItemsSource="{Binding DataContext.MarginPresets, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          Text="{Binding OuterMargin, UpdateSourceTrigger=PropertyChanged}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Abstand zum Rand (px)" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Nur Links/Rechts – in der Mitte ist die Uhr immer exakt zentriert." Style="{StaticResource RowHint}" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <ComboBox DockPanel.Dock="Right" IsEditable="True" Width="140" VerticalAlignment="Center"
                                                          ItemsSource="{Binding DataContext.SpacingPresets, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          Text="{Binding InnerSpacing, UpdateSourceTrigger=PropertyChanged}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Mindestabstand zu anderen Widgets (px)" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Freie Widgets kommen der Uhr nie näher als dieser Abstand." Style="{StaticResource RowHint}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </StackPanel>


                                        <!-- Freie Widgets: Position per Drag & Drop -->
                                        <TextBlock Visibility="{Binding FreeVisibility}" Text="{Binding PositionText}" Style="{StaticResource RowHint}" Margin="0,4,0,0" />

                                        <!-- Audio-Widgets: Geräteauswahl je Instanz -->
                                        <StackPanel Visibility="{Binding AudioVisibility}" Margin="0,6,0,0">
                                            <Border Style="{StaticResource Divider}" />
                                            <DockPanel Style="{StaticResource Row}">
                                                <ui:HotkeyBox DockPanel.Dock="Right" Width="240" VerticalAlignment="Center" Hotkey="{Binding Hotkey}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Tastenkürzel" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Wechselt bei jedem Druck zum nächsten Gerät dieses Widgets (von links nach rechts) – auch in Spielen. Auch eine einzelne Taste ist möglich; Rücktaste oder Entf löscht." Style="{StaticResource RowHint}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding HotkeyWarning}" Visibility="{Binding HotkeyWarningVisibility}" Foreground="#FDBC4B" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </DockPanel>
                                            <Border Style="{StaticResource Divider}" />
                                            <DockPanel Style="{StaticResource Row}">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding AllDevices}" VerticalAlignment="Center" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Alle aktiven Geräte anzeigen" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Aus: nur die angehakten Geräte. Für ein Widget je Gerät genau eines anhaken." Style="{StaticResource RowHint}" />
                                                </StackPanel>
                                            </DockPanel>
                                            <ItemsControl ItemsSource="{Binding Devices}" IsEnabled="{Binding DeviceListEnabled}" Margin="0,0,0,4">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding Selected}" Margin="0,3">
                                                            <StackPanel Orientation="Horizontal">
                                                                <audio:AudioIconView IconKey="{Binding IconKey}" Size="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- Mess-Widgets: Darstellung, Bezeichnung, Warnfarben, Einheit, Grafikkarte -->
                                        <StackPanel Visibility="{Binding MetricVisibility}" Margin="0,6,0,0">
                                            <Border Style="{StaticResource Divider}" />
                                            <DockPanel Style="{StaticResource Row}">
                                                <ComboBox DockPanel.Dock="Right" Width="260" VerticalAlignment="Center"
                                                          ItemsSource="{Binding DataContext.MetricStyleOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding MetricStyle}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Darstellung" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="{Binding MetricStyleHint}" Style="{StaticResource RowHint}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}" Visibility="{Binding DriveVisibility}">
                                                <ComboBox DockPanel.Dock="Right" Width="320" VerticalAlignment="Center"
                                                          ItemsSource="{Binding DataContext.DriveOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding DriveChoice}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Laufwerk" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Lokale Festplatten, SSDs und USB-Laufwerke. Netzlaufwerke werden nicht abgefragt." Style="{StaticResource RowHint}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}" Visibility="{Binding GpuChoiceVisibility}">
                                                <ComboBox DockPanel.Dock="Right" Width="320" VerticalAlignment="Center"
                                                          ItemsSource="{Binding DataContext.GpuOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding GpuChoice}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Grafikkarte" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Automatisch: die Karte mit dem meisten eigenen Videospeicher." Style="{StaticResource RowHint}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}" Visibility="{Binding AmountVisibility}">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Metric.ShowAmount}" VerticalAlignment="Center" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding AmountTitle}" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="{Binding AmountHint}" Style="{StaticResource RowHint}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Metric.ShowCaption}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding CaptionTitle}" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}" Visibility="{Binding WarnColorsVisibility}">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Metric.WarnColors}" VerticalAlignment="Center" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Warnfarben" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="{Binding WarnColorsHint}" Style="{StaticResource RowHint}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                        </StackPanel>

                                        <!-- Netzwerk: Name, Signal, Schnellzugriff -->
                                        <StackPanel Visibility="{Binding NetworkVisibility}" Margin="0,6,0,0">
                                            <Border Style="{StaticResource Divider}" />
                                            <DockPanel Style="{StaticResource Row}">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Network.ShowName}" VerticalAlignment="Center" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Netzwerkname anzeigen" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="WLAN: SSID, LAN: Name des Netzwerks laut Windows. Aus: nur das Symbol." Style="{StaticResource RowHint}" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Network.ShowSignal}" VerticalAlignment="Center" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Signalstärke in Prozent anzeigen" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Nur WLAN. Das Symbol zeigt die Signalstufe immer. Ab Windows 11 24H2 braucht Windows dafür den Standortzugriff für Desktop-Apps." Style="{StaticResource RowHint}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Network.ShowSettingsButton}" VerticalAlignment="Center" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Schnellzugriff auf die Netzwerkeinstellungen" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Schaltfläche im Popup, das sich beim Klick auf das Widget öffnet." Style="{StaticResource RowHint}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </StackPanel>

                                        <!-- Lautstärke: Gerät, Anzeige, Mausrad, Rechtsklick -->
                                        <StackPanel Visibility="{Binding VolumeVisibility}" Margin="0,6,0,0">
                                            <Border Style="{StaticResource Divider}" />
                                            <DockPanel Style="{StaticResource Row}">
                                                <ComboBox DockPanel.Dock="Right" Width="320" VerticalAlignment="Center"
                                                          ItemsSource="{Binding DataContext.VolumeFlowOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding VolumeFlow}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Gerät" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Immer das aktuelle Standardgerät – wechselt automatisch mit." Style="{StaticResource RowHint}" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Volume.ShowPercent}" VerticalAlignment="Center" />
                                                <TextBlock Text="Lautstärke in Prozent anzeigen" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}" Visibility="{Binding MicrophoneVisibility}">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Volume.HighlightMuted}" VerticalAlignment="Center" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Stummes Mikrofon rot hervorheben" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Symbol und Text rot auf rotem Grund – auch wenn es in Windows oder einer anderen App stummgeschaltet wurde." Style="{StaticResource RowHint}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}" Visibility="{Binding MicrophoneVisibility}">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Volume.MuteSound}" VerticalAlignment="Center" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Signalton beim Stummschalten" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Zwei kurze Töne: absteigend = stumm, aufsteigend = Mikrofon an. Hörbar auch im exklusiven Vollbild." Style="{StaticResource RowHint}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Volume.ShowOverlay}" VerticalAlignment="Center" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Anzeige beim Tastenkürzel" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Blendet kurz oben auf dem Bildschirm ein, was das Tastenkürzel bewirkt hat (z. B. „Mikrofon stumm“) – auch über randlosen Vollbildspielen. Die Tastenkürzel stehen weiter unten." Style="{StaticResource RowHint}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Volume.ShowBar}" VerticalAlignment="Center" />
                                                <TextBlock Text="Füllbalken anzeigen" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <ComboBox DockPanel.Dock="Right" Width="140" VerticalAlignment="Center"
                                                          ItemsSource="{Binding DataContext.WheelStepOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedItem="{Binding WheelStep}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Schrittweite des Mausrads (%)" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Änderung je Raste über dem Widget oder im Regler-Popup." Style="{StaticResource RowHint}" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Volume.RightClickMutes}" VerticalAlignment="Center" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Rechtsklick schaltet stumm" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Aus: Rechtsklick öffnet wie überall das Kontextmenü der Fläche; Stummschalten dann über den Regler." Style="{StaticResource RowHint}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}" Visibility="{Binding OutputVisibility}">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Volume.ShowApps}" VerticalAlignment="Center" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Lautstärke je App im Regler" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Wie der Windows-Lautstärkemixer: ein Regler je Programm mit Ton. Mausrad über einer App regelt nur diese, Klick aufs Symbol schaltet sie stumm." Style="{StaticResource RowHint}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                        </StackPanel>

                                        <!-- Timer: Liste, Anzeige, Benachrichtigung -->
                                        <StackPanel Visibility="{Binding TimerVisibility}" Margin="0,6,0,0">
                                            <Border Style="{StaticResource Divider}" />
                                            <TextBlock Text="Timer" Style="{StaticResource RowTitle}" Margin="0,8,0,0" />
                                            <TextBlock Text="Dauer als Minuten („25“), min:s („1:30“), h:min:s („1:00:00“) oder mit Einheiten („1h 30m“). Timer lassen sich auch direkt im Popup anlegen und bearbeiten." Style="{StaticResource RowHint}" TextWrapping="Wrap" />
                                            <ItemsControl ItemsSource="{Binding TimerRows}" Margin="0,6,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,3">
                                                            <DockPanel>
                                                                <Button DockPanel.Dock="Right" Command="{Binding RemoveCommand}" ToolTip="Timer entfernen" Margin="8,0,0,0" Padding="10,6">
                                                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Glyph}" FontSize="12" />
                                                                </Button>
                                                                <TextBox DockPanel.Dock="Right" Width="140" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="Dauer"
                                                                         Text="{Binding DurationText, UpdateSourceTrigger=PropertyChanged}" />
                                                                <TextBox VerticalAlignment="Center" ToolTip="Name" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                                            </DockPanel>
                                                            <TextBlock Text="Ungültige Dauer – gespeichert wird der letzte gültige Wert." Visibility="{Binding DurationHintVisibility}"
                                                                       Foreground="#FDBC4B" FontSize="12" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button Command="{Binding AddTimerCommand}" HorizontalAlignment="Left" Margin="0,6,0,4">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,8,0" />
                                                    <TextBlock Text="Timer hinzufügen" />
                                                </StackPanel>
                                            </Button>
                                            <DockPanel Style="{StaticResource Row}">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Timer.ShowAllActive}" VerticalAlignment="Center" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Alle laufenden Timer auf der Fläche zeigen" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Aus: nur der Timer, der als Nächstes abläuft. Ohne laufenden Timer steht nur die Sanduhr da." Style="{StaticResource RowHint}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Timer.ShowName}" VerticalAlignment="Center" />
                                                <TextBlock Text="Namen neben der Restzeit anzeigen" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Timer.ShowProgress}" VerticalAlignment="Center" />
                                                <TextBlock Text="Fortschrittsbalken unter der Restzeit" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Timer.Notify}" VerticalAlignment="Center" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Windows-Benachrichtigung nach Ablauf" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Erscheint auch, wenn die Fläche bei Vollbild ausgeblendet ist, und respektiert „Nicht stören“." Style="{StaticResource RowHint}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <ComboBox DockPanel.Dock="Right" Width="200" VerticalAlignment="Center"
                                                          ItemsSource="{Binding DataContext.TimerSoundOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding TimerSound}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Signalton" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Klänge aus dem Windows-Soundschema (Systemsteuerung → Sound → Sounds)." Style="{StaticResource RowHint}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </StackPanel>

                                        <!-- Stoppuhr: Format, Runden -->
                                        <StackPanel Visibility="{Binding StopwatchVisibility}" Margin="0,6,0,0">
                                            <Border Style="{StaticResource Divider}" />
                                            <DockPanel Style="{StaticResource Row}">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Stopwatch.ShowMilliseconds}" VerticalAlignment="Center" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Millisekunden auf der Fläche anzeigen" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Die Anzeige wird dann während des Laufs etwa 20-mal je Sekunde aktualisiert. Im Popup stehen sie immer." Style="{StaticResource RowHint}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Stopwatch.AlwaysShowHours}" VerticalAlignment="Center" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Stunden immer anzeigen" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="„0:05:12“ statt „05:12“ – die Breite bleibt ab dem Start gleich." Style="{StaticResource RowHint}" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Stopwatch.EnableLaps}" VerticalAlignment="Center" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Rundenzeiten erfassen" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Schaltfläche „Runde“ im Popup; schnellste Runde grün, langsamste rot." Style="{StaticResource RowHint}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </StackPanel>

                                        <!-- Upload/Download: Adapter, Richtung, Intervall, Darstellung -->
                                        <StackPanel Visibility="{Binding TrafficVisibility}" Margin="0,6,0,0">
                                            <Border Style="{StaticResource Divider}" />
                                            <DockPanel Style="{StaticResource Row}">
                                                <ComboBox DockPanel.Dock="Right" Width="340" VerticalAlignment="Center"
                                                          ItemsSource="{Binding DataContext.AdapterOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding TrafficAdapter}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Netzwerkadapter" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Alle: Summe der verbundenen physischen Adapter (LAN, WLAN)." Style="{StaticResource RowHint}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <ComboBox DockPanel.Dock="Right" Width="240" VerticalAlignment="Center"
                                                          ItemsSource="{Binding DataContext.TrafficDirectionOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding TrafficDirection}" />
                                                <TextBlock Text="Anzeige" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <ComboBox DockPanel.Dock="Right" Width="140" VerticalAlignment="Center"
                                                          ItemsSource="{Binding DataContext.TrafficIntervalOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding TrafficInterval}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Aktualisierungsintervall" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Längere Intervalle glätten die Werte; gemessen wird für alle Widgets gemeinsam." Style="{StaticResource RowHint}" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Traffic.Stacked}" VerticalAlignment="Center" />
                                                <TextBlock Text="Download und Upload untereinander" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Traffic.ShowGraph}" VerticalAlignment="Center" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Verlaufsgrafik" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Die letzten 40 Messungen; Download gefüllt, Upload als Linie." Style="{StaticResource RowHint}" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Traffic.UseBits}" VerticalAlignment="Center" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="In Bit pro Sekunde (Mbit/s)" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Wie Provider und Router; aus: Byte pro Sekunde (MB/s) wie im Explorer." Style="{StaticResource RowHint}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </StackPanel>

                                        <!-- Bild: Datei, Größe, Ecken, Deckkraft, Klick-Aktion -->
                                        <StackPanel Visibility="{Binding ImageVisibility}" Margin="0,6,0,0">
                                            <Border Style="{StaticResource Divider}" />
                                            <TextBlock Text="Bilddatei" Style="{StaticResource RowTitle}" Margin="0,8,0,0" />
                                            <DockPanel Margin="0,6,0,0">
                                                <Button DockPanel.Dock="Right" Command="{Binding BrowseImageCommand}" Margin="8,0,0,0" Padding="12,6">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE8E5;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,8,0" />
                                                        <TextBlock Text="Auswählen …" />
                                                    </StackPanel>
                                                </Button>
                                                <TextBox VerticalAlignment="Center" ToolTip="Vollständiger Pfad der Bilddatei" Text="{Binding ImagePath, UpdateSourceTrigger=LostFocus}" />
                                            </DockPanel>
                                            <TextBlock Text="PNG, JPG, GIF (erstes Bild), BMP, ICO, TIFF oder WebP. Die Datei bleibt, wo sie ist – verschieben oder löschen, und das Widget zeigt einen Hinweis." Style="{StaticResource RowHint}" TextWrapping="Wrap" Margin="0,4,0,4" />
                                            <DockPanel Style="{StaticResource Row}">
                                                <ComboBox DockPanel.Dock="Right" IsEditable="True" Width="140" VerticalAlignment="Center"
                                                          ItemsSource="{Binding DataContext.ImageHeightPresets, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          Text="{Binding Image.Height, UpdateSourceTrigger=PropertyChanged}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Höhe (px)" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Die Breite ergibt sich aus dem Seitenverhältnis." Style="{StaticResource RowHint}" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <TextBox DockPanel.Dock="Right" Width="140" VerticalAlignment="Center" Text="{Binding Image.Width, UpdateSourceTrigger=PropertyChanged}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Breite (px)" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="0 = automatisch. Mit fester Breite wird das Bild passend zugeschnitten." Style="{StaticResource RowHint}" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <ComboBox DockPanel.Dock="Right" IsEditable="True" Width="140" VerticalAlignment="Center"
                                                          ItemsSource="{Binding DataContext.CornerRadiusPresets, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          Text="{Binding Image.CornerRadius, UpdateSourceTrigger=PropertyChanged}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Ecken abrunden (px)" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Halbe Höhe bei quadratischem Bild = Kreis." Style="{StaticResource RowHint}" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <TextBox DockPanel.Dock="Right" Width="140" VerticalAlignment="Center" Text="{Binding Image.Opacity, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="Deckkraft (%)" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock Text="Bei Klick öffnen" Style="{StaticResource RowTitle}" Margin="0,8,0,0" />
                                            <TextBox Margin="0,6,0,0" Text="{Binding Image.ClickTarget, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="z. B. https://example.org, C:\Users\Name\Bilder oder notepad.exe" />
                                            <TextBlock Text="Optional: Webadresse, Ordner, Datei oder Programm. Leer = Klick macht nichts." Style="{StaticResource RowHint}" TextWrapping="Wrap" Margin="0,4,0,4" />
                                        </StackPanel>

                                        <!-- Notiz: Text, Schrift, Breite, Hintergrund -->
                                        <StackPanel Visibility="{Binding NoteVisibility}" Margin="0,6,0,0">
                                            <Border Style="{StaticResource Divider}" />
                                            <TextBlock Text="Text" Style="{StaticResource RowTitle}" Margin="0,8,0,0" />
                                            <TextBox Margin="0,6,0,0" Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                                     TextWrapping="Wrap" MinHeight="90" MaxHeight="260" VerticalScrollBarVisibility="Auto" SpellCheck.IsEnabled="True" />
                                            <DockPanel Style="{StaticResource Row}">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Note.EditOnClick}" VerticalAlignment="Center" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Per Klick auf der Fläche bearbeiten" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Öffnet ein kleines Fenster zum Schreiben; gespeichert wird beim Schließen." Style="{StaticResource RowHint}" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <ComboBox DockPanel.Dock="Right" IsEditable="True" Width="140" VerticalAlignment="Center"
                                                          ItemsSource="{Binding DataContext.NoteFontSizePresets, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          Text="{Binding Note.FontSize, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="Schriftgröße (px)" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <ComboBox DockPanel.Dock="Right" Width="260" VerticalAlignment="Center"
                                                          ItemsSource="{Binding DataContext.ClockFontFamilies, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedItem="{Binding NoteFontFamily}" MaxDropDownHeight="420"
                                                          ItemTemplate="{StaticResource FontItem}" ItemsPanel="{StaticResource VirtualPanel}" />
                                                <TextBlock Text="Schriftart" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Note.Bold}" VerticalAlignment="Center" />
                                                <TextBlock Text="Fett" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <ComboBox DockPanel.Dock="Right" Width="140" VerticalAlignment="Center"
                                                          ItemsSource="{Binding DataContext.TextAlignmentOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding NoteAlignment}" />
                                                <TextBlock Text="Ausrichtung" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <ComboBox DockPanel.Dock="Right" IsEditable="True" Width="140" VerticalAlignment="Center"
                                                          ItemsSource="{Binding DataContext.NoteWidthPresets, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          Text="{Binding Note.MaxWidth, UpdateSourceTrigger=PropertyChanged}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Breite für Zeilenumbruch (px)" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="0 = kein automatischer Umbruch, nur deine eigenen Zeilenumbrüche." Style="{StaticResource RowHint}" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding NoteHasBackground}" VerticalAlignment="Center" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Hintergrund wie ein Notizzettel" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Abgerundeter Hintergrund hinter dem Text. Auch halbtransparent möglich (#AARRGGBB)." Style="{StaticResource RowHint}" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}" IsEnabled="{Binding NoteHasBackground}">
                                                <ui:ColorField DockPanel.Dock="Right" VerticalAlignment="Center" Value="{Binding NoteBackground, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="Hintergrundfarbe" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </StackPanel>

                                        <!-- Medien: Cover, Interpret, Steuerung -->
                                        <StackPanel Visibility="{Binding MediaVisibility}" Margin="0,6,0,0">
                                            <Border Style="{StaticResource Divider}" />
                                            <DockPanel Style="{StaticResource Row}">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Media.ShowCover}" VerticalAlignment="Center" />
                                                <TextBlock Text="Cover anzeigen" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Media.ShowArtist}" VerticalAlignment="Center" />
                                                <TextBlock Text="Interpret unter dem Titel" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Media.ShowControls}" VerticalAlignment="Center" />
                                                <TextBlock Text="Schaltflächen Zurück, Wiedergabe/Pause, Weiter" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Media.FixedTextWidth}" VerticalAlignment="Center" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Feste Breite für Titel und Interpret" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Die Schaltflächen bleiben bei jedem Titel an derselben Stelle – praktisch, um mehrere Titel hintereinander zu überspringen. Kurze Titel lassen eine Lücke, ein fehlendes Cover einen Platzhalter." Style="{StaticResource RowHint}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <TextBox DockPanel.Dock="Right" Width="140" VerticalAlignment="Center" Text="{Binding Media.MaxTextWidth, UpdateSourceTrigger=PropertyChanged}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Breite des Textes (px)" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Mit fester Breite genau so breit, sonst höchstens. Der ganze Titel steht immer auch im Tooltip." Style="{StaticResource RowHint}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Media.ScrollLongText}" VerticalAlignment="Center" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Lange Titel durchlaufen lassen" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Passt Titel oder Interpret nicht in die Breite, wandert der Text nach kurzer Pause durch. Aus: Er endet mit „…“." Style="{StaticResource RowHint}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Media.HideWhenIdle}" VerticalAlignment="Center" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Ohne Wiedergabe ausblenden" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Aus: „Keine Wiedergabe“ bleibt stehen." Style="{StaticResource RowHint}" />
                                                </StackPanel>
                                            </DockPanel>
                                            <TextBlock Style="{StaticResource RowHint}" TextWrapping="Wrap" Margin="0,4,0,4"
                                                       Text="Zeigt, was Windows als aktuelle Wiedergabe meldet – dasselbe wie im Lautstärke-Popup von Windows (Spotify, Browser, Medienwiedergabe …)." />
                                        </StackPanel>

                                        <!-- Countdown: Titel, Ziel, Anzeige -->
                                        <StackPanel Visibility="{Binding CountdownVisibility}" Margin="0,6,0,0">
                                            <Border Style="{StaticResource Divider}" />
                                            <DockPanel Style="{StaticResource Row}">
                                                <TextBox DockPanel.Dock="Right" Width="260" VerticalAlignment="Center" Text="{Binding CountdownTitle, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="Titel" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Countdown.ShowTitle}" VerticalAlignment="Center" />
                                                <TextBlock Text="Titel vor der Restzeit anzeigen" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <DatePicker Width="170" SelectedDate="{Binding CountdownDate}" VerticalAlignment="Center" />
                                                    <TextBox Width="80" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="Uhrzeit, z. B. 18:00"
                                                             Text="{Binding CountdownTime, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CountdownTargetTitle}" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="{Binding CountdownRepeatHint}" Style="{StaticResource RowHint}" TextWrapping="Wrap" />
                                                    <TextBlock Text="Ungültige Uhrzeit – gespeichert wird die letzte gültige." Visibility="{Binding CountdownTimeHintVisibility}"
                                                               Foreground="#FDBC4B" FontSize="12" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <ComboBox DockPanel.Dock="Right" Width="200" VerticalAlignment="Center"
                                                          ItemsSource="{Binding DataContext.CountdownRepeatOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding CountdownRepeat}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Wiederholen" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Z. B. bis zum täglichen oder wöchentlichen Reset in einem Spiel. Danach zählt der Countdown automatisch bis zum nächsten Termin." Style="{StaticResource RowHint}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <ComboBox DockPanel.Dock="Right" Width="300" VerticalAlignment="Center"
                                                          ItemsSource="{Binding DataContext.CountdownStyleOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding CountdownStyle}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Anzeige" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Unter einem Tag zeigen alle Formen Stunden und Minuten." Style="{StaticResource RowHint}" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <TextBox DockPanel.Dock="Right" Width="260" VerticalAlignment="Center" Text="{Binding Countdown.DoneText, UpdateSourceTrigger=PropertyChanged}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Text nach Ablauf" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Erscheint, sobald das Ziel erreicht ist – bei Wiederholung eine Minute lang, dann geht es zum nächsten Termin." Style="{StaticResource RowHint}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                        </StackPanel>

                                        <!-- Trennlinie: Form, Richtung, Maße -->
                                        <StackPanel Visibility="{Binding SeparatorVisibility}" Margin="0,6,0,0">
                                            <Border Style="{StaticResource Divider}" />
                                            <DockPanel Style="{StaticResource Row}">
                                                <ComboBox DockPanel.Dock="Right" Width="200" VerticalAlignment="Center"
                                                          ItemsSource="{Binding DataContext.SeparatorStyleOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding SeparatorStyle}" />
                                                <TextBlock Text="Form" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Separator.Horizontal}" VerticalAlignment="Center" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Waagerecht" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Für Widgets untereinander (freie Platzierung). Aus: senkrecht zwischen Widgets nebeneinander." Style="{StaticResource RowHint}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <ComboBox DockPanel.Dock="Right" IsEditable="True" Width="140" VerticalAlignment="Center"
                                                          ItemsSource="{Binding DataContext.SeparatorLengthPresets, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          Text="{Binding Separator.Length, UpdateSourceTrigger=PropertyChanged}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Länge (px)" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Bei „Nur Abstand“ die Breite des Abstands." Style="{StaticResource RowHint}" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <TextBox DockPanel.Dock="Right" Width="140" VerticalAlignment="Center" Text="{Binding Separator.Thickness, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="Stärke bzw. Punktgröße (px)" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <TextBox DockPanel.Dock="Right" Width="140" VerticalAlignment="Center" Text="{Binding Separator.Padding, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="Abstand zu beiden Seiten (px)" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </StackPanel>

                                        <!-- Zeichnen: Werkzeugleiste und Verhalten beim Beenden -->
                                        <StackPanel Visibility="{Binding DrawVisibility}" Margin="0,6,0,0">
                                            <Border Style="{StaticResource Divider}" />
                                            <TextBlock Text="Klick auf den Stift startet das Zeichnen auf dem Monitor unter der Maus. Werkzeug, Farbe und Stärke wählst du in der Werkzeugleiste. Esc oder „Fertig“ beendet das Zeichnen, Strg + Z macht rückgängig, Entf löscht alles. Das Gezeichnete liegt immer über allen Fenstern, auch über Spielen im randlosen Vollbild." Style="{StaticResource RowHint}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                            <DockPanel Style="{StaticResource Row}">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Draw.ToolbarHorizontal}" VerticalAlignment="Center" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Werkzeugleiste waagerecht" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Zwei Zeilen oben am Bildschirm. Aus: zwei Spalten am linken Rand. Lässt sich auch in der Werkzeugleiste umschalten und mit der Maus verschieben." Style="{StaticResource RowHint}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Draw.ClearOnExit}" VerticalAlignment="Center" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Beim Beenden alles löschen" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Aus: Das Gezeichnete bleibt nach „Fertig“ stehen (z. B. als Markierung), Klicks gehen wieder an die Fenster darunter." Style="{StaticResource RowHint}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Draw.ShowClearButton}" VerticalAlignment="Center" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Papierkorb auf der Fläche" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Erscheint neben dem Stift, solange etwas gezeichnet ist, und löscht mit einem Klick alles." Style="{StaticResource RowHint}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                        </StackPanel>

                                        <!-- Zwischenablage: Länge, Einfügen, Bilder, Angeheftetes -->
                                        <StackPanel Visibility="{Binding ClipboardVisibility}" Margin="0,6,0,0">
                                            <Border Style="{StaticResource Divider}" />
                                            <DockPanel Style="{StaticResource Row}">
                                                <ComboBox DockPanel.Dock="Right" Width="140" VerticalAlignment="Center"
                                                          ItemsSource="{Binding DataContext.ClipboardSizeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedItem="{Binding ClipboardMaxItems}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Einträge im Verlauf" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Der Verlauf liegt nur im Arbeitsspeicher und ist nach einem Neustart leer. Inhalte, die Passwortmanager als vertraulich markieren, werden nicht aufgenommen." Style="{StaticResource RowHint}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Clipboard.PasteOnSelect}" VerticalAlignment="Center" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Nach der Auswahl direkt einfügen" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Fügt den Eintrag mit Strg + V in das Fenster ein, das vor dem Öffnen aktiv war. Aus: nur in die Zwischenablage kopieren." Style="{StaticResource RowHint}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Clipboard.KeepImages}" VerticalAlignment="Center" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Bilder aufnehmen" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Z. B. Bildschirmfotos. Höchstens die 5 neuesten, damit der Speicherbedarf klein bleibt." Style="{StaticResource RowHint}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Clipboard.ShowCount}" VerticalAlignment="Center" />
                                                <TextBlock Text="Anzahl der Einträge neben dem Symbol" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <Button DockPanel.Dock="Right" Content="Alle entfernen" Command="{Binding ClearPinnedCommand}" VerticalAlignment="Center" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Angeheftete Texte" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="{Binding PinnedText}" Style="{StaticResource RowHint}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                        </StackPanel>

                                        <!-- Weltuhr: Zeitzonen und Anzeige -->
                                        <StackPanel Visibility="{Binding WorldClockVisibility}" Margin="0,6,0,0">
                                            <Border Style="{StaticResource Divider}" />
                                            <TextBlock Text="Zeitzonen" Style="{StaticResource RowTitle}" Margin="0,8,0,0" />
                                            <ItemsControl ItemsSource="{Binding ZoneRows}" Margin="0,4,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Margin="0,4">
                                                            <Button DockPanel.Dock="Right" Command="{Binding RemoveCommand}" ToolTip="Zeitzone entfernen" Margin="8,0,0,0" Padding="10,6" VerticalAlignment="Top">
                                                                <TextBlock Text="&#xE74D;" Style="{StaticResource Glyph}" FontSize="12" />
                                                            </Button>
                                                            <TextBox DockPanel.Dock="Right" Width="140" Margin="8,0,0,0" VerticalAlignment="Top"
                                                                     Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding LabelPlaceholder}" />
                                                            <ComboBox ItemsSource="{Binding DataContext.TimeZoneOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding TimeZoneId}"
                                                                      ItemsPanel="{StaticResource VirtualPanel}" MaxDropDownHeight="420" />
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="Rechts ein eigener Name; leer = Name der Zeitzone (z. B. „Osaka“). Bis zu 12 Zeitzonen." Style="{StaticResource RowHint}" Margin="0,2,0,0" />
                                            <Button Command="{Binding AddZoneCommand}" HorizontalAlignment="Left" Margin="0,8,0,4">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,8,0" />
                                                    <TextBlock Text="Zeitzone hinzufügen" />
                                                </StackPanel>
                                            </Button>
                                            <DockPanel Style="{StaticResource Row}">
                                                <TextBox DockPanel.Dock="Right" Width="140" VerticalAlignment="Center" Text="{Binding WorldClock.TimeFormat, UpdateSourceTrigger=LostFocus}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Zeitformat" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="„HH:mm“ = 24 Stunden, „h:mm tt“ = 12 Stunden, „HH:mm:ss“ mit Sekunden." Style="{StaticResource RowHint}" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding WorldClock.ShowLabels}" VerticalAlignment="Center" />
                                                <TextBlock Text="Ortsnamen vor der Uhrzeit" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding WorldClock.ShowAllInBar}" VerticalAlignment="Center" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Alle Zeitzonen auf der Fläche" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Aus: nur die erste – alle stehen im Popup." Style="{StaticResource RowHint}" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource Row}">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding WorldClock.ShowDayOffset}" VerticalAlignment="Center" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Anderen Tag kennzeichnen" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Kleines „+1“ bzw. „−1“, wenn es dort schon morgen oder noch gestern ist." Style="{StaticResource RowHint}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </StackPanel>

                                        <!-- Schnellstart: Einträge und Anzeige -->
                                        <StackPanel Visibility="{Binding LauncherVisibility}" Margin="0,6,0,0">
                                            <Border Style="{StaticResource Divider}" />
                                            <TextBlock Text="Einträge" Style="{StaticResource RowTitle}" Margin="0,8,0,0" />
                                            <TextBlock Text="Programme, Dateien, Ordner oder Webadressen. Am schnellsten: Dateien, Ordner oder Links direkt auf das Widget auf der Fläche ziehen." Style="{StaticResource RowHint}" TextWrapping="Wrap" />
                                            <ItemsControl ItemsSource="{Binding LauncherRows}" Margin="0,4,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#0FFFFFFF" CornerRadius="6" Padding="10,8" Margin="0,4">
                                                            <DockPanel>
                                                                <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="16" Height="16" Margin="0,8,10,0" VerticalAlignment="Top" />
                                                                <Button DockPanel.Dock="Right" Command="{Binding RemoveCommand}" ToolTip="Eintrag entfernen" Margin="8,0,0,0" Padding="10,6" VerticalAlignment="Top">
                                                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Glyph}" FontSize="12" />
                                                                </Button>
                                                                <StackPanel>
                                                                    <TextBox Text="{Binding Path, UpdateSourceTrigger=LostFocus}" ToolTip="Pfad oder Webadresse" />
                                                                    <DockPanel Margin="0,6,0,0">
                                                                        <TextBox DockPanel.Dock="Right" Width="170" Margin="8,0,0,0" Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" ToolTip="Startparameter (nur Programme, optional)" />
                                                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding NamePlaceholder}" />
                                                                    </DockPanel>
                                                                </StackPanel>
                                                            </DockPanel>
