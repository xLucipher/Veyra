                                                </StackPanel>
                                            </DockPanel>
                                            <TextBlock Text="Gemessen wird das Programm im Vordergrund (DirectX 9 bis 12), nur solange die Fläche sichtbar ist. Damit du die FPS im Spiel siehst: unter Vollbild &amp; Spiele „Bei randlosem Vollbild ausblenden“ ausschalten und die Fläche im Vordergrund lassen." Style="{StaticResource RowHint}" TextWrapping="Wrap" Margin="0,4,0,4" />
                                        </StackPanel>

                                        <!-- Helligkeit und Nachtmodus -->
                                        <StackPanel Visibility="{Binding BrightnessVisibility}" Margin="0,6,0,0">
                                            <Border Style="{StaticResource Divider}" />
                                            <TextBlock Text="Externe Monitore über DDC/CI (muss im Menü des Monitors eingeschaltet sein), Laptop-Bildschirme über den Grafiktreiber. Mausrad auf dem Widget ändert alle Bildschirme, Klick öffnet je Bildschirm einen Regler." Style="{StaticResource RowHint}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                            <DockPanel Style="{StaticResource Row}">
                                                <ComboBox DockPanel.Dock="Right" Width="140" VerticalAlignment="Center"
                                                          ItemsSource="{Binding DataContext.WheelStepOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedItem="{Binding BrightnessStep}" />
                                                <TextBlock Text="Schrittweite (%)" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
