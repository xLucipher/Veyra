                                                                <TextBlock Text="{Binding HotkeyWarning}" Visibility="{Binding HotkeyWarningVisibility}" Foreground="#FDBC4B" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- Farben: alle Widgets außer der Uhr -->
